# Cloudflare Workers/Pages _headers
#
# assets ディレクトリ (= ./dist) 直下に置くと適用される。
# 公式: https://developers.cloudflare.com/workers/static-assets/

# release feed (scripts/gen-release-feed.mjs が生成)。
# Studio (studio.hapbeat.com) など別オリジンのブラウザから読むため CORS が必須。
# 再生成は deploy 単位なので 30 分の陳腐化は許容する
# (hapbeat-contracts specs/release-feed.md §2)。
/releases.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=1800

# Hapbeat を体験できるイベントの予定 (hapbeat.com のトップが読む)。
# 手で編集する静的 JSON。形式は tests/demo-events.test.mjs の検査と
# workspace dev-notes/devtools-site/demo-events-feed.md。
/demo-events.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=600
