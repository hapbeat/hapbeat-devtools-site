---
/**
 * /showcase/<id>/ — デモの詳細ページ。src/data/showcase.ts の 1 件から生成する。
 * サムネイル (または動画) / 概要 / 体験に使うもの / 体験の流れ / 触覚の見どころ。
 * 下部に前後のデモへの移動を置き、タブレットで続けて見せられるようにする。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ShowcaseThumb from '../../components/ShowcaseThumb.astro';
import { PUBLISHED_SHOWCASE_DEMOS, categoryLabel, type ShowcaseDemo } from '../../data/showcase';

export function getStaticPaths() {
  return PUBLISHED_SHOWCASE_DEMOS.map((demo, i, all) => ({
    params: { id: demo.id },
    props: {
      demo,
      prev: all[(i - 1 + all.length) % all.length],
      next: all[(i + 1) % all.length],
    },
  }));
}

interface Props {
  demo: ShowcaseDemo;
  prev: ShowcaseDemo;
  next: ShowcaseDemo;
}

const { demo, prev, next } = Astro.props;
---

<StarlightPage
  frontmatter={{
    title: demo.title,
    description: demo.tagline,
    template: 'splash',
  }}
>
  <div class="hb-scd not-content" style={`--_hue: ${demo.hue}`}>
    <a class="hb-scd__back" href="/showcase/">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 5 12 12 5" />
      </svg>
      デモ一覧へ
    </a>

    <div class="hb-scd__top">
      <div class="hb-scd__media">
        <ShowcaseThumb demo={demo} size="hero" />
      </div>
      <div class="hb-scd__summary">
        <div class="hb-scd__tags">
          {demo.categories.map((c) => <span class="hb-scd__cat">{categoryLabel(c)}</span>)}
        </div>
        {demo.subtitle && <p class="hb-scd__sub">{demo.subtitle}</p>}
        <p class="hb-scd__tagline">{demo.tagline}</p>
        <dl class="hb-scd__specs">
          {
            demo.specs.map((s) => (
              <div>
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <p class="hb-scd__desc">{demo.description}</p>

    <div class="hb-scd__cols">
      <section>
        <h2>体験の流れ</h2>
        <ol class="hb-scd__flow">
          {demo.flow.map((f) => <li>{f}</li>)}
        </ol>
      </section>
      <section>
        <h2>触覚の見どころ</h2>
        <ul class="hb-scd__haptics">
          {demo.haptics.map((h) => <li>{h}</li>)}
        </ul>
      </section>
    </div>

    <nav class="hb-scd__pager" aria-label="ほかのデモ">
      <a href={`/showcase/${prev.id}/`} rel="prev">
        <span>前のデモ</span>
        {prev.icon} {prev.title}
      </a>
      <a href={`/showcase/${next.id}/`} rel="next">
        <span>次のデモ</span>
        {next.icon} {next.title}
      </a>
    </nav>
  </div>
</StarlightPage>

<style>
  .hb-scd {
    margin-bottom: 32px;
  }
  .hb-scd__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    margin-bottom: 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--hb-ink-soft);
    text-decoration: none;
  }
  .hb-scd__back:hover {
    color: var(--hb-ink);
  }

  .hb-scd__top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .hb-scd__media {
    border: 1px solid var(--hb-line);
    border-radius: var(--hb-radius-lg);
    overflow: hidden;
    box-shadow: var(--hb-shadow-md);
  }

  .hb-scd__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .hb-scd__cat {
    font-size: 12.5px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    color: oklch(0.42 0.12 var(--_hue));
    background: oklch(0.94 0.04 var(--_hue));
  }
  :global([data-theme='dark']) .hb-scd__cat {
    color: oklch(0.9 0.08 var(--_hue));
    background: oklch(0.36 0.08 var(--_hue));
  }
  .hb-scd__sub {
    margin: 12px 0 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--hb-ink-mute);
  }
  .hb-scd__tagline {
    margin: 8px 0 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--hb-ink);
  }

  .hb-scd__specs {
    margin: 18px 0 0;
    border-top: 1px solid var(--hb-line);
  }
  .hb-scd__specs div {
    display: grid;
    grid-template-columns: 7em 1fr;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--hb-line);
  }
  .hb-scd__specs dt {
    font-size: 13px;
    font-weight: 700;
    color: var(--hb-ink-mute);
  }
  .hb-scd__specs dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--hb-ink-soft);
  }

  .hb-scd__desc {
    margin: 28px 0 0;
    max-width: 75ch;
    font-size: 16px;
    line-height: 1.85;
    color: var(--hb-ink-soft);
  }

  .hb-scd__cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 26px;
  }
  .hb-scd__cols section {
    padding: 18px 22px 20px;
    border: 1px solid var(--hb-line);
    border-radius: var(--hb-radius-lg);
    background: var(--hb-bg-elev);
  }
  /* .sl-markdown-content h2 (components.css) より強くするため親クラスを重ねる */
  .hb-scd .hb-scd__cols h2 {
    margin: 0 0 12px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: normal;
    color: var(--hb-ink);
  }
  .hb-scd .hb-scd__cols h2::before {
    content: none;
  }
  .hb-scd__flow,
  .hb-scd__haptics {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--hb-ink-soft);
  }
  .hb-scd__flow {
    counter-reset: flow;
  }
  .hb-scd__flow li,
  .hb-scd__haptics li {
    position: relative;
    margin: 0;
    padding-left: 34px;
  }
  .hb-scd__flow li::before {
    counter-increment: flow;
    content: counter(flow);
    position: absolute;
    left: 0;
    top: 1px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: oklch(0.98 0.01 var(--_hue));
    background: oklch(0.55 0.13 var(--_hue));
  }
  .hb-scd__haptics li::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 2px solid oklch(0.55 0.13 var(--_hue));
    box-shadow: 0 0 0 4px oklch(0.55 0.13 var(--_hue) / 0.18);
  }

  .hb-scd__pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    margin-top: 32px;
  }
  .hb-scd__pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border: 1px solid var(--hb-line);
    border-radius: var(--hb-radius);
    background: var(--hb-bg-elev);
    color: var(--hb-ink);
    font-weight: 700;
    text-decoration: none;
  }
  .hb-scd__pager a[rel='next'] {
    text-align: right;
  }
  .hb-scd__pager a:hover {
    border-color: var(--hb-ink-mute);
  }
  .hb-scd__pager span {
    font-size: 12px;
    font-weight: 600;
    color: var(--hb-ink-mute);
  }

  @media (max-width: 50rem) {
    .hb-scd__top,
    .hb-scd__cols {
      grid-template-columns: 1fr;
    }
  }
</style>
