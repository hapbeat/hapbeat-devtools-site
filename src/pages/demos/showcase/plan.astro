---
/**
 * /demos/showcase/plan/ — プリセット作成。展示用 Android リモコン (Hapbeat Demo Remote) に渡すプランを作るページ。
 *
 * デモ一覧で来場者・スタッフが選んだデモを、順番・設定つきで 1〜3 件のプリセットに組み、
 * QR (とリンク) にする。リモコンはアプリの QR 読み取りで取り込む。形式の正本は
 * hapbeat-contracts specs/demo-session.md「リモコンへのプリセット受け渡し（QR / リンク）」、
 * 符号化と検査は src/lib/remote-preset.mjs。QR は uqr (MIT, nayuki の QR Code generator
 * ベース) をビルドに同梱して端末内で作る (外部への通信なし)。
 *
 * 体験の順番はサムネイル付きのカードで、つまみかサムネイルをドラッグして並べ替える
 * (Pointer Events。タブレットの指でも動く)。つまみにフォーカスして上下キーでも動かせる。
 *
 * 作りかけのプランはこのブラウザの localStorage にだけ保存する (他の端末とは共有しない)。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { jsonForScript, remoteCatalog } from '../../../data/showcase';

const catalog = remoteCatalog();
---

<StarlightPage
  frontmatter={{
    title: 'プリセット作成',
    description: 'デモの順番と設定を組み、展示用 Android リモコンに QR で渡します。',
    template: 'splash',
    pagefind: false,
  }}
>
  <script type="application/json" id="hb-plan-catalog" set:html={jsonForScript(catalog)} />

  <div class="hb-plan not-content">
    <a class="hb-plan__back" href="/demos/showcase/">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 5 12 12 5" />
      </svg>
      デモ一覧へ
    </a>
    <p class="hb-plan__lead">
      体験するデモを順番に並べてプリセットにし、展示用リモコン（Hapbeat Demo Remote）のアプリで下の QR を読み取ります。リモコンは確認画面を出してから取り込み、取り込んだだけではデモを始めません。
    </p>

    <div class="hb-plan__layout">
      <div class="hb-plan__main">
        <div class="hb-plan__tabs" role="tablist" aria-label="プリセット" data-tabs></div>

        <div class="hb-plan__preset">
          <label class="hb-plan__name">
            <span>プリセット名</span>
            <input type="text" data-name autocomplete="off" placeholder="例: XR Kaigi A" />
          </label>
          <p class="hb-plan__name-note" data-name-note aria-live="polite"></p>

          <h2 class="hb-plan__h">デモを追加</h2>
          <ul class="hb-plan__palette" data-palette></ul>

          <h2 class="hb-plan__h">体験の順番</h2>
          <ol class="hb-plan__steps" data-steps></ol>
          <p class="hb-plan__empty" data-empty>上のデモを押すと、ここに順番に並びます。並べ替えはカードをドラッグします。</p>
        </div>
      </div>

      <aside class="hb-plan__side">
        <div class="hb-plan__meter">
          <div class="hb-plan__meter-row">
            <span>QR に入るデータ</span>
            <span data-bytes></span>
          </div>
          <div class="hb-plan__bar"><span data-bar></span></div>
        </div>
        <div class="hb-plan__qr" data-qr-box>
          <button type="button" class="hb-plan__qr-img" data-qr aria-label="QR を大きく表示" disabled></button>
          <p class="hb-plan__qr-hint" data-qr-hint></p>
        </div>
        <ul class="hb-plan__errors" data-errors aria-live="polite"></ul>
        <div class="hb-plan__zoom" data-zoom hidden>
          <div class="hb-plan__zoom-qr" data-zoom-qr></div>
          <p>画面のどこかを押すと閉じます</p>
        </div>
        <div class="hb-plan__link" data-link-box hidden>
          <input type="text" readonly data-link aria-label="プリセットのリンク" />
          <div class="hb-plan__link-actions">
            <button type="button" data-copy>リンクをコピー</button>
            <a data-open target="_blank" rel="noopener noreferrer">内容を確認</a>
          </div>
        </div>
        <div class="hb-plan__file">
          <div class="hb-plan__link-actions">
            <button type="button" data-export>JSON に書き出す</button>
            <button type="button" data-import>JSON を読み込む</button>
          </div>
          <input type="file" accept="application/json,.json" data-import-file hidden />
          <p class="hb-plan__file-note" data-file-note aria-live="polite">プリセット一式を JSON ファイルで保存・読み込みできます。</p>
        </div>
      </aside>
    </div>
  </div>
</StarlightPage>

<script>
  import { encode } from 'uqr';
  import {
    MAX_NAME_CODE_POINTS,
    parseJsonStrict,
    serializePayload,
    MAX_PAYLOAD_BYTES,
    MAX_PRESETS,
    MAX_STEPS,
    encodeToken,
    nameProblem,
    payloadByteLength,
    presetPageUrl,
    validatePayload,
  } from '../../../lib/remote-preset.mjs';

  type Option = { id: string; label: string; default: string; values: { value: string; label: string }[]; when?: Record<string, string[]> };
  type Entry = { demoId: string; title: string; subtitle?: string; icon: string; hue: number; thumbnail?: string; options: Option[] };
  type Step = { demoId: string; options: Record<string, string>; retry: boolean };
  type Preset = { name: string; steps: Step[] };
  type State = { active: number; presets: Preset[] };

  const STORAGE_KEY = 'hb-remote-plan-v1';
  const root = document.querySelector<HTMLElement>('.hb-plan');
  const catalogEl = document.getElementById('hb-plan-catalog');

  if (root && catalogEl) {
    const catalog: Entry[] = JSON.parse(catalogEl.textContent || '[]');
    const byId = new Map(catalog.map((e) => [e.demoId, e]));
    const $ = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;

    const tabsEl = $('[data-tabs]');
    const nameEl = $<HTMLInputElement>('[data-name]');
    const nameNoteEl = $('[data-name-note]');
    const paletteEl = $('[data-palette]');
    const stepsEl = $('[data-steps]');
    const emptyEl = $('[data-empty]');
    const bytesEl = $('[data-bytes]');
    const barEl = $('[data-bar]');
    const qrEl = $('[data-qr]');
    const qrHintEl = $('[data-qr-hint]');
    const zoomEl = $('[data-zoom]');
    const zoomQrEl = $('[data-zoom-qr]');
    const errorsEl = $('[data-errors]');
    const linkBox = $('[data-link-box]');
    const linkEl = $<HTMLInputElement>('[data-link]');
    const copyEl = $<HTMLButtonElement>('[data-copy]');
    const openEl = $<HTMLAnchorElement>('[data-open]');
    const exportEl = $<HTMLButtonElement>('[data-export]');
    const importEl = $<HTMLButtonElement>('[data-import]');
    const importFileEl = $<HTMLInputElement>('[data-import-file]');
    const fileNoteEl = $('[data-file-note]');

    const newPreset = (n: number): Preset => ({ name: `プリセット ${n}`, steps: [] });

    function load(): State {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const s = JSON.parse(raw) as State;
          const presets = (s.presets || [])
            .slice(0, MAX_PRESETS)
            .map((p) => ({
              name: typeof p.name === 'string' ? p.name : '',
              steps: (p.steps || []).filter((st) => byId.has(st.demoId)).slice(0, MAX_STEPS).map((st) => ({ demoId: st.demoId, options: { ...(st.options || {}) }, retry: st.retry !== false })),
            }));
          if (presets.length) return { active: Math.min(Math.max(0, s.active | 0), presets.length - 1), presets };
        }
      } catch {
        /* 保存が使えない・壊れている場合は新しく始める */
      }
      return { active: 0, presets: [newPreset(1)] };
    }

    const state = load();

    function save() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch {
        /* プライベートモード等では保存しない */
      }
    }

    // when の条件を、現在の値 (無ければ既定値) で判定する。
    function activeOptions(entry: Entry, chosen: Record<string, string>) {
      const valueOf = (id: string) => chosen[id] ?? entry.options.find((o) => o.id === id)?.default;
      return entry.options.filter((o) => !o.when || Object.entries(o.when).every(([k, vs]) => vs.includes(valueOf(k) ?? '')));
    }

    // 送る JSON。既定値と、条件で無効になった設定は省く (省いた設定は Hub が既定値を使う)。retry は false のときだけ書く。
    function buildPayload() {
      return {
        version: 1,
        presets: state.presets.map((p) => ({
          name: p.name,
          steps: p.steps.map((st) => {
            const entry = byId.get(st.demoId)!;
            const options: Record<string, string> = {};
            for (const o of activeOptions(entry, st.options)) {
              const v = st.options[o.id];
              if (v !== undefined && v !== o.default) options[o.id] = v;
            }
            const step: { demo_id: string; options?: Record<string, string>; retry?: boolean } = { demo_id: st.demoId };
            if (Object.keys(options).length) step.options = options;
            if (!st.retry) step.retry = false;
            return step;
          }),
        })),
      };
    }

    function el<K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> & { className?: string } = {}, ...children: (Node | string)[]) {
      const node = document.createElement(tag);
      Object.assign(node, props);
      for (const c of children) node.append(c);
      return node;
    }

    function renderTabs() {
      tabsEl.replaceChildren();
      state.presets.forEach((p, i) => {
        const tab = el('button', { type: 'button', className: 'hb-plan__tab', textContent: `${i + 1}. ${p.name.trim() || '（名前なし）'}` });
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-selected', String(i === state.active));
        tab.addEventListener('click', () => {
          state.active = i;
          renderAll();
        });
        tabsEl.append(tab);
      });
      if (state.presets.length < MAX_PRESETS) {
        const add = el('button', { type: 'button', className: 'hb-plan__tab hb-plan__tab--add', textContent: '+ プリセットを追加' });
        add.addEventListener('click', () => {
          state.presets.push(newPreset(state.presets.length + 1));
          state.active = state.presets.length - 1;
          renderAll();
        });
        tabsEl.append(add);
      }
      if (state.presets.length > 1) {
        const del = el('button', { type: 'button', className: 'hb-plan__tab hb-plan__tab--del', textContent: 'このプリセットを削除' });
        del.addEventListener('click', () => {
          state.presets.splice(state.active, 1);
          state.active = Math.max(0, state.active - 1);
          renderAll();
        });
        tabsEl.append(del);
      }
    }

    function renderPalette() {
      paletteEl.replaceChildren();
      const full = current().steps.length >= MAX_STEPS;
      for (const entry of catalog) {
        const media = entry.thumbnail
          ? el('img', { className: 'bare', src: entry.thumbnail, alt: '', loading: 'lazy', decoding: 'async' })
          : el('span', { className: 'hb-plan__ph', textContent: entry.icon });
        const btn = el('button', { type: 'button', className: 'hb-plan__pick', disabled: full }, media, el('span', { className: 'hb-plan__pick-title', textContent: entry.title }));
        btn.style.setProperty('--_hue', String(entry.hue));
        btn.setAttribute('aria-label', `${entry.title} を追加`);
        btn.addEventListener('click', () => {
          current().steps.push({ demoId: entry.demoId, options: {}, retry: true });
          renderAll();
        });
        paletteEl.append(el('li', {}, btn));
      }
    }

    function move(from: number, to: number) {
      const steps = current().steps;
      if (to < 0 || to >= steps.length || from === to) return;
      steps.splice(to, 0, steps.splice(from, 1)[0]);
      renderAll();
    }

    // つまみ / サムネイルのドラッグで並べ替える。つかんだカードは指に追従し、
    // ほかのカードは入る位置を空けるようにずれる。離した位置に挿入する。
    function startDrag(e: PointerEvent, li: HTMLElement, index: number) {
      if (e.button !== 0) return;
      e.preventDefault();
      const handle = e.currentTarget as HTMLElement;
      handle.setPointerCapture(e.pointerId);
      const items = [...stepsEl.children] as HTMLElement[];
      const rects = items.map((n) => n.getBoundingClientRect());
      const gap = rects.length > 1 ? rects[1].top - rects[0].bottom : 10;
      const shift = rects[index].height + gap;
      const startY = e.clientY;
      let target = index;
      li.classList.add('is-dragging');
      stepsEl.classList.add('is-sorting');

      const onMove = (ev: PointerEvent) => {
        const dy = ev.clientY - startY;
        li.style.transform = `translateY(${dy}px)`;
        const center = rects[index].top + rects[index].height / 2 + dy;
        target = rects.filter((r, j) => j !== index && r.top + r.height / 2 < center).length;
        items.forEach((n, j) => {
          if (j === index) return;
          let off = 0;
          if (index < j && j <= target) off = -shift;
          else if (target <= j && j < index) off = shift;
          n.style.transform = off ? `translateY(${off}px)` : '';
        });
      };
      const onEnd = () => {
        handle.removeEventListener('pointermove', onMove);
        handle.removeEventListener('pointerup', onEnd);
        handle.removeEventListener('pointercancel', onEnd);
        items.forEach((n) => (n.style.transform = ''));
        li.classList.remove('is-dragging');
        stepsEl.classList.remove('is-sorting');
        if (target !== index) move(index, target);
      };
      handle.addEventListener('pointermove', onMove);
      handle.addEventListener('pointerup', onEnd);
      handle.addEventListener('pointercancel', onEnd);
    }

    function renderSteps() {
      const steps = current().steps;
      stepsEl.replaceChildren();
      emptyEl.hidden = steps.length > 0;
      steps.forEach((st, i) => {
        const entry = byId.get(st.demoId)!;

        const grip = el('button', { type: 'button', className: 'hb-plan__grip', textContent: '⠿' });
        grip.setAttribute('aria-label', `${i + 1} 番目 ${entry.title}。ドラッグまたは上下キーで並べ替え`);
        grip.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowUp' && e.key !== 'ArrowDown') return;
          e.preventDefault();
          const to = i + (e.key === 'ArrowUp' ? -1 : 1);
          if (to < 0 || to >= steps.length) return;
          move(i, to);
          stepsEl.children[to]?.querySelector<HTMLElement>('.hb-plan__grip')?.focus();
        });
        const thumb = entry.thumbnail
          ? el('img', { className: 'bare hb-plan__step-img', src: entry.thumbnail, alt: '', draggable: false })
          : el('span', { className: 'hb-plan__step-img hb-plan__ph', textContent: entry.icon });
        const handle = el('div', { className: 'hb-plan__handle' }, grip, el('span', { className: 'hb-plan__step-no', textContent: String(i + 1) }), thumb);

        const del = el('button', { type: 'button', className: 'hb-plan__del', textContent: '✕' });
        del.setAttribute('aria-label', `${entry.title} を削除`);
        del.addEventListener('click', () => {
          steps.splice(i, 1);
          renderAll();
        });

        const body = el('div', { className: 'hb-plan__step-body' });
        for (const o of activeOptions(entry, st.options)) {
          const select = el('select');
          for (const v of o.values) {
            select.append(el('option', { value: v.value, textContent: v.value === o.default ? `${v.label}（既定）` : v.label }));
          }
          select.value = st.options[o.id] ?? o.default;
          select.addEventListener('change', () => {
            st.options[o.id] = select.value;
            renderAll();
          });
          body.append(el('label', { className: 'hb-plan__opt' }, el('span', { textContent: o.label }), select));
        }
        const retry = el('input', { type: 'checkbox', checked: st.retry });
        retry.addEventListener('change', () => {
          st.retry = retry.checked;
          renderAll();
        });
        body.append(el('label', { className: 'hb-plan__retry' }, retry, el('span', { textContent: '終了後に「もう一度」を出す' })));

        const main = el('div', { className: 'hb-plan__step-main' }, el('span', { className: 'hb-plan__step-title', textContent: entry.title }), body);
        const li = el('li', { className: 'hb-plan__step' }, handle, main, del);
        li.style.setProperty('--_hue', String(entry.hue));
        handle.addEventListener('pointerdown', (e) => startDrag(e, li, i));
        stepsEl.append(li);
      });
    }

    function qrSvg(text: string) {
      // byte モード・誤り訂正 M (仕様は L か M)。バイト列で渡して byte モードに固定する。
      const qr = encode(Array.from(new TextEncoder().encode(text)), { ecc: 'M', border: 4 });
      let d = '';
      qr.data.forEach((row, y) =>
        row.forEach((dark, x) => {
          if (dark) d += `M${x} ${y}h1v1h-1z`;
        }),
      );
      const ns = 'http://www.w3.org/2000/svg';
      const svg = document.createElementNS(ns, 'svg');
      svg.setAttribute('viewBox', `0 0 ${qr.size} ${qr.size}`);
      svg.setAttribute('role', 'img');
      svg.setAttribute('aria-label', 'プリセットの QR コード');
      svg.setAttribute('shape-rendering', 'crispEdges');
      const bg = document.createElementNS(ns, 'rect');
      bg.setAttribute('width', String(qr.size));
      bg.setAttribute('height', String(qr.size));
      bg.setAttribute('fill', '#fff');
      const path = document.createElementNS(ns, 'path');
      path.setAttribute('d', d);
      path.setAttribute('fill', '#000');
      svg.append(bg, path);
      return svg;
    }

    function renderOutput() {
      const payload = buildPayload();
      const bytes = payloadByteLength(payload);
      const left = MAX_PAYLOAD_BYTES - bytes;
      bytesEl.textContent = left >= 0 ? `残り ${left} / ${MAX_PAYLOAD_BYTES} bytes` : `${-left} bytes 超過（上限 ${MAX_PAYLOAD_BYTES} bytes）`;
      barEl.style.width = `${Math.min(100, (bytes / MAX_PAYLOAD_BYTES) * 100)}%`;
      root!.toggleAttribute('data-over', left < 0);

      const errors = validatePayload(payload);
      errorsEl.replaceChildren(...errors.map((e) => el('li', { textContent: e })));
      qrEl.replaceChildren();
      zoomQrEl.replaceChildren();
      (qrEl as HTMLButtonElement).disabled = errors.length > 0;
      if (errors.length) {
        linkBox.hidden = true;
        qrHintEl.textContent = '名前とデモをそろえると QR が出ます。';
        return;
      }
      const url = presetPageUrl(encodeToken(payload));
      qrEl.append(qrSvg(url));
      zoomQrEl.append(qrSvg(url));
      qrHintEl.textContent = 'リモコンのアプリで読み取ってください。読みにくいときは QR を押すと大きく表示します。';
      linkBox.hidden = false;
      linkEl.value = url;
      openEl.href = url;
    }

    function current() {
      return state.presets[state.active];
    }

    function renderAll() {
      renderTabs();
      if (document.activeElement !== nameEl) nameEl.value = current().name;
      const np = nameProblem(current().name);
      nameNoteEl.textContent = np ?? `${[...current().name].length} / ${MAX_NAME_CODE_POINTS} 文字`;
      nameNoteEl.toggleAttribute('data-error', !!np);
      renderPalette();
      renderSteps();
      renderOutput();
      save();
    }

    nameEl.addEventListener('input', () => {
      current().name = nameEl.value;
      renderAll();
    });
    nameEl.addEventListener('blur', () => renderAll());

    qrEl.addEventListener('click', () => {
      zoomEl.hidden = false;
    });
    zoomEl.addEventListener('click', () => {
      zoomEl.hidden = true;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') zoomEl.hidden = true;
    });

    // JSON 書き出し / 読み込み。形式は QR と同じペイロード ({version, presets})。
    exportEl.addEventListener('click', () => {
      const payload = buildPayload();
      const errors = validatePayload(payload);
      if (errors.length) {
        fileNoteEl.textContent = `書き出せません: ${errors[0]}`;
        return;
      }
      const safe = (state.presets[0]?.name ?? '').replace(/[^0-9A-Za-z\u3040-\u30ff\u4e00-\u9fff_-]+/g, '_').slice(0, 40);
      const blob = new Blob([JSON.stringify(JSON.parse(serializePayload(payload)), null, 2) + '\n'], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `hapbeat-preset${safe ? '-' + safe : ''}.json`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
      fileNoteEl.textContent = `${a.download} を保存しました。`;
    });
    importEl.addEventListener('click', () => importFileEl.click());
    importFileEl.addEventListener('change', async () => {
      const file = importFileEl.files?.[0];
      importFileEl.value = '';
      if (!file) return;
      try {
        const payload = parseJsonStrict((await file.text()).replace(/^\uFEFF/, '')) as {
          presets: { name: string; steps: { demo_id: string; options?: Record<string, string>; retry?: boolean }[] }[];
        };
        const errors = validatePayload(payload);
        if (errors.length) throw new Error(errors[0]);
        const unknown = payload.presets.flatMap((p) => p.steps.map((s) => s.demo_id)).filter((id) => !byId.has(id));
        if (unknown.length) throw new Error(`この一覧に無いデモがあります: ${[...new Set(unknown)].join(', ')}`);
        if (!confirm('いまのプリセットを、読み込んだ内容で置き換えますか？')) return;
        state.presets = payload.presets.map((p) => ({
          name: p.name,
          steps: p.steps.map((s) => {
            const entry = byId.get(s.demo_id)!;
            const options: Record<string, string> = {};
            for (const [k, v] of Object.entries(s.options ?? {})) {
              if (entry.options.some((o) => o.id === k && o.values.some((x) => x.value === v))) options[k] = v;
            }
            return { demoId: s.demo_id, options, retry: s.retry !== false };
          }),
        }));
        state.active = 0;
        renderAll();
        fileNoteEl.textContent = `${file.name} を読み込みました（${state.presets.length} 件）。`;
      } catch (e) {
        fileNoteEl.textContent = `読み込めません: ${e instanceof Error ? e.message : '形式が正しくありません'}`;
      }
    });

    copyEl.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(linkEl.value);
        copyEl.textContent = 'コピーしました';
      } catch {
        linkEl.select();
        copyEl.textContent = '選択しました';
      }
      setTimeout(() => (copyEl.textContent = 'リンクをコピー'), 1600);
    });

    renderAll();
  }
</script>

<style>
