---
/**
 * /demos/showcase/<id>/ — デモの詳細ページ。src/data/showcase.ts の 1 件から生成する。
 *
 * 構成 (上から):
 *   - 見出し: 「デモ一覧へ」→ タイトル + 日本語名 + カテゴリのタグ (1 行、狭いと折り返す)。
 *     Starlight の標準タイトル欄は使わず (下の :global で隠す)、このページで組む
 *   - PV | 一言の説明と「触覚体験」(どんな触覚を感じられるか)
 *   - 概要文 | 機材・人数などの小さな表
 *   - 「体験の流れ」: 1 ステップ = 番号付きスクショ 1 枚 + 文の小さなカード (flow[])。
 *     スクショはクリックで拡大 (lightbox)
 *   - ほかのデモ (サムネイル + タイトルの小さなカード)
 * 画像はサイト共通の本文画像スタイル (.sl-markdown-content img の枠・角丸・影) を
 * class="bare" で外し、このページ側で形を決める。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ShowcaseThumb from '../../../components/ShowcaseThumb.astro';
import { PUBLISHED_SHOWCASE_DEMOS, categoryLabel, type ShowcaseDemo } from '../../../data/showcase';

export function getStaticPaths() {
  return PUBLISHED_SHOWCASE_DEMOS.map((demo) => ({
    params: { id: demo.id },
    props: { demo, others: PUBLISHED_SHOWCASE_DEMOS.filter((d) => d.id !== demo.id) },
  }));
}

interface Props {
  demo: ShowcaseDemo;
  others: ShowcaseDemo[];
}

const { demo, others } = Astro.props;
---

<StarlightPage
  frontmatter={{
    title: demo.title,
    description: demo.tagline,
    template: 'splash',
  }}
>
  <div class="hb-scd not-content" style={`--_hue: ${demo.hue}`}>
    <header class="hb-scd__head">
      <a class="hb-scd__back" href="/demos/showcase/">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12" />
          <polyline points="12 19 5 12 12 5" />
        </svg>
        デモ一覧へ
      </a>
      <div class="hb-scd__titlerow">
        <h1 class="hb-scd__title">{demo.title}</h1>
        {demo.subtitle && <span class="hb-scd__sub">{demo.subtitle}</span>}
        <div class="hb-scd__tags">
          {demo.categories.map((c) => <span class="hb-scd__cat">{categoryLabel(c)}</span>)}
        </div>
      </div>
    </header>

    <div class="hb-scd__top">
      <div class="hb-scd__media">
        <ShowcaseThumb demo={demo} size="hero" />
      </div>
      <div class="hb-scd__summary">
        <p class="hb-scd__tagline">{demo.tagline}</p>
        <section class="hb-scd__block">
          <h2>触覚体験</h2>
          <ul class="hb-scd__haptics">
            {demo.haptics.map((h) => <li>{h}</li>)}
          </ul>
        </section>
      </div>
    </div>

    <div class="hb-scd__about">
      <p class="hb-scd__desc">{demo.description}</p>
      <table class="hb-scd__specs">
        <tbody>
          {
            demo.specs.map((s) => (
              <tr>
                <th scope="row">{s.label}</th>
                <td>{s.value}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <section class="hb-scd__story" aria-labelledby="hb-scd-flow">
      <h2 id="hb-scd-flow">体験の流れ</h2>
      <ol class="hb-scd__steps">
        {
          demo.flow.map((step, i) => (
            <li>
              <div class="hb-scd__step-media">
                {step.shot ? (
                  <img class="bare" src={step.shot} alt={step.alt ?? step.text} loading="lazy" decoding="async" width="1280" height="720" />
                ) : (
                  <div class="hb-scd__step-ph" aria-hidden="true">{demo.icon}</div>
                )}
                <span class="hb-scd__num" aria-hidden="true">{i + 1}</span>
              </div>
              <p>{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <nav class="hb-scd__others" aria-label="ほかのデモ">
      <h2>ほかのデモ</h2>
      <ul>
        {
          others.map((d) => (
            <li>
              <a href={`/demos/showcase/${d.id}/`} data-astro-reload>
                <ShowcaseThumb demo={d} />
                <span>{d.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</StarlightPage>

<style>
  /* Starlight 標準のタイトル欄 (h1#_top だけの最初の content-panel) は使わない */
  :global(.content-panel:has(> .sl-container > h1#_top)) {
    display: none;
  }
  :global(.content-panel:has(.hb-scd)) {
    border-top: 0;
  }

  .hb-scd {
    margin-bottom: 32px;
  }
  /* 見出しの h2 は .sl-markdown-content h2 (上余白 56px・ドット) より強くして打ち消す */
  .hb-scd.not-content h2 {
    margin: 0 0 12px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: normal;
    color: var(--hb-ink);
  }
  .hb-scd.not-content h2::before {
    content: none;
  }

  /* ---- 見出し ---- */
  .hb-scd__head {
    margin-bottom: 18px;
  }
  .hb-scd__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    font-size: 14px;
    font-weight: 600;
    color: var(--hb-ink-soft);
    text-decoration: none;
  }
  .hb-scd__back:hover {
    color: var(--hb-ink);
  }
  .hb-scd__titlerow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 16px;
    margin-top: 4px;
  }
  .hb-scd .hb-scd__titlerow .hb-scd__title {
    margin: 0;
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--hb-ink);
  }
  .hb-scd__sub {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: normal;
    color: var(--hb-ink-mute);
  }
  .hb-scd__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .hb-scd__cat {
    font-size: 12.5px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    color: oklch(0.42 0.12 var(--_hue));
    background: oklch(0.94 0.04 var(--_hue));
  }
  :global([data-theme='dark']) .hb-scd__cat {
    color: oklch(0.9 0.08 var(--_hue));
    background: oklch(0.36 0.08 var(--_hue));
  }

  /* ---- PV | 説明・触覚体験 ---- */
  .hb-scd__top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .hb-scd__media {
    border-radius: var(--hb-radius-lg);
    overflow: hidden;
    box-shadow: var(--hb-shadow-md);
  }
  .hb-scd__tagline {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--hb-ink);
  }
  .hb-scd__block {
    margin-top: 18px;
  }
  .hb-scd.not-content .hb-scd__block h2 {
    margin-bottom: 8px;
    font-size: 15px;
  }
  .hb-scd__haptics {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--hb-ink-soft);
  }
  .hb-scd__haptics li {
    position: relative;
    margin: 0;
    padding-left: 26px;
  }
  .hb-scd__haptics li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 2px solid oklch(0.55 0.13 var(--_hue));
    box-shadow: 0 0 0 4px oklch(0.55 0.13 var(--_hue) / 0.18);
  }

  /* ---- 概要文 | 機材などの表 ---- */
  .hb-scd__about {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    margin-top: 28px;
  }
  .hb-scd__desc {
    margin: 0;
    font-size: 16px;
    line-height: 1.85;
    color: var(--hb-ink-soft);
  }
  /* サイト共通の表スタイル (.sl-markdown-content table の枠・背景・横スクロール) を打ち消す */
  .hb-scd .hb-scd__about .hb-scd__specs {
    display: table;
    width: 100%;
    margin: 0;
    border: 0;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.55;
    overflow: visible;
  }
  .hb-scd .hb-scd__about .hb-scd__specs th,
  .hb-scd .hb-scd__about .hb-scd__specs td {
    padding: 7px 0;
    border: 0;
    border-bottom: 1px solid var(--hb-line);
    background: transparent;
    text-align: left;
    vertical-align: top;
    line-height: 1.55;
  }
  .hb-scd .hb-scd__about .hb-scd__specs tr:first-child th,
  .hb-scd .hb-scd__about .hb-scd__specs tr:first-child td {
    border-top: 1px solid var(--hb-line);
  }
  .hb-scd .hb-scd__about .hb-scd__specs th {
    width: 6.5em;
    padding-right: 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--hb-ink-mute);
    white-space: nowrap;
  }
  .hb-scd .hb-scd__about .hb-scd__specs td {
    color: var(--hb-ink-soft);
  }

  /* ---- 体験の流れ: 1 ステップ = 番号付きスクショ + 文のカード ---- */
  .hb-scd__story {
    margin-top: 36px;
  }
  .hb-scd__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 16px;
  }
  .hb-scd__steps li {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-radius: var(--hb-radius);
    background: var(--hb-bg-elev);
    box-shadow: var(--hb-shadow-sm);
    overflow: hidden;
  }
  .hb-scd__step-media {
    position: relative;
  }
  /* クリックで拡大は astro.config.mjs の lightbox (.sl-markdown-content img) が行う */
  .hb-scd__step-media img,
  .hb-scd__step-ph {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .hb-scd__step-media img {
    cursor: zoom-in;
  }
  .hb-scd__step-ph {
    display: grid;
    place-items: center;
    font-size: 32px;
    background: oklch(0.88 0.07 var(--_hue));
  }
  :global([data-theme='dark']) .hb-scd__step-ph {
    background: oklch(0.34 0.08 var(--_hue));
  }
  .hb-scd__num {
    position: absolute;
    top: 8px;
    left: 8px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    color: #fff;
    background: oklch(0.55 0.13 var(--_hue));
    box-shadow: 0 1px 3px oklch(0 0 0 / 0.35);
  }
  .hb-scd__steps p {
    margin: 0;
    padding: 10px 12px 12px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--hb-ink-soft);
  }

  /* ---- ほかのデモ ---- */
  .hb-scd__others {
    margin-top: 40px;
  }
  .hb-scd__others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
    gap: 14px;
  }
  .hb-scd__others li {
    margin: 0;
  }
  .hb-scd__others a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--hb-ink);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .hb-scd__others a :global(.hb-sc-thumb) {
    border-radius: var(--hb-radius);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hb-scd__others a:hover :global(.hb-sc-thumb) {
    transform: translateY(-2px);
    box-shadow: var(--hb-shadow-md);
  }

  @media (max-width: 50rem) {
    .hb-scd__top,
    .hb-scd__about {
      grid-template-columns: 1fr;
    }
  }
</style>
