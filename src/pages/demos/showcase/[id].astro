---
/**
 * /demos/showcase/<id>/ — デモの詳細ページ。src/data/showcase.ts の 1 件から生成する。
 * 上段: PV | どんな触覚体験か (触覚体験) と大まかな体験の流れ。どういう体験ができるかを
 * 最初に読めるようにする。その下に概要文・スクショ、目立たない位置に機材・人数などの表。
 * 下部に、ほかのデモをサムネイル + タイトルの小さなカードで並べる (順番に意味は無い)。
 * サイト共通の本文画像スタイル (.sl-markdown-content img の枠・角丸・影) は
 * class="bare" で外し、このページ側で形を決める。
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import ShowcaseThumb from '../../../components/ShowcaseThumb.astro';
import { PUBLISHED_SHOWCASE_DEMOS, categoryLabel, type ShowcaseDemo } from '../../../data/showcase';

export function getStaticPaths() {
  return PUBLISHED_SHOWCASE_DEMOS.map((demo, _i, all) => ({
    params: { id: demo.id },
    props: { demo, others: all.filter((d) => d.id !== demo.id) },
  }));
}

interface Props {
  demo: ShowcaseDemo;
  others: ShowcaseDemo[];
}

const { demo, others } = Astro.props;
---

<StarlightPage
  frontmatter={{
    title: demo.title,
    description: demo.tagline,
    template: 'splash',
  }}
>
  <div class="hb-scd not-content" style={`--_hue: ${demo.hue}`}>
    <a class="hb-scd__back" href="/demos/showcase/">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="19" y1="12" x2="5" y2="12" />
        <polyline points="12 19 5 12 12 5" />
      </svg>
      デモ一覧へ
    </a>

    <div class="hb-scd__top">
      <div class="hb-scd__media">
        <ShowcaseThumb demo={demo} size="hero" />
      </div>
      <div class="hb-scd__summary">
        <div class="hb-scd__tags">
          {demo.categories.map((c) => <span class="hb-scd__cat">{categoryLabel(c)}</span>)}
        </div>
        {demo.subtitle && <p class="hb-scd__sub">{demo.subtitle}</p>}
        <p class="hb-scd__tagline">{demo.tagline}</p>
        <section class="hb-scd__block">
          <h2>触覚体験</h2>
          <ul class="hb-scd__haptics">
            {demo.haptics.map((h) => <li>{h}</li>)}
          </ul>
        </section>
        <section class="hb-scd__block">
          <h2>体験の流れ</h2>
          <ol class="hb-scd__flow">
            {demo.flow.map((f) => <li>{f}</li>)}
          </ol>
        </section>
      </div>
    </div>

    <p class="hb-scd__desc">{demo.description}</p>

    {
      demo.screenshots && demo.screenshots.length > 0 && (
        <ul class="hb-scd__gallery" aria-label="スクリーンショット">
          {demo.screenshots.map((s) => (
            <li>
              <figure>
                <img class="bare" src={s.src} alt={s.caption} loading="lazy" decoding="async" width="1280" height="720" />
                <figcaption>{s.caption}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )
    }

    <dl class="hb-scd__specs" aria-label="体験に使うもの">
      {
        demo.specs.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))
      }
    </dl>

    <nav class="hb-scd__others" aria-label="ほかのデモ">
      <h2>ほかのデモ</h2>
      <ul>
        {
          others.map((d) => (
            <li>
              <a href={`/demos/showcase/${d.id}/`} data-astro-reload>
                <ShowcaseThumb demo={d} />
                <span>{d.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</StarlightPage>

<style>
  .hb-scd {
    margin-bottom: 32px;
  }
  .hb-scd__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    margin-bottom: 14px;
    font-size: 14px;
    font-weight: 600;
    color: var(--hb-ink-soft);
    text-decoration: none;
  }
  .hb-scd__back:hover {
    color: var(--hb-ink);
  }

  .hb-scd__top {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .hb-scd__media {
    border-radius: var(--hb-radius-lg);
    overflow: hidden;
    box-shadow: var(--hb-shadow-md);
  }

  .hb-scd__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .hb-scd__cat {
    font-size: 12.5px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 999px;
    color: oklch(0.42 0.12 var(--_hue));
    background: oklch(0.94 0.04 var(--_hue));
  }
  :global([data-theme='dark']) .hb-scd__cat {
    color: oklch(0.9 0.08 var(--_hue));
    background: oklch(0.36 0.08 var(--_hue));
  }
  .hb-scd__sub {
    margin: 12px 0 0;
    font-size: 15px;
    font-weight: 700;
    color: var(--hb-ink-mute);
  }
  .hb-scd__tagline {
    margin: 8px 0 0;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--hb-ink);
  }

  /* 触覚体験・体験の流れ (上段右) */
  .hb-scd__block {
    margin-top: 18px;
  }
  .hb-scd .hb-scd__block h2 {
    margin: 0 0 8px;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: normal;
    color: var(--hb-ink);
  }
  .hb-scd .hb-scd__block h2::before {
    content: none;
  }

  .hb-scd__desc {
    margin: 28px 0 0;
    font-size: 16px;
    line-height: 1.85;
    color: var(--hb-ink-soft);
  }

  /* クリックで拡大は astro.config.mjs の lightbox (.sl-markdown-content img) が行う */
  .hb-scd__gallery {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
    gap: 14px;
  }
  .hb-scd__gallery li {
    margin: 0;
  }
  .hb-scd__gallery figure {
    margin: 0;
  }
  .hb-scd__gallery img {
    display: block;
    width: 100%;
    height: auto;
    max-height: none;
    margin: 0;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--hb-radius);
    cursor: pointer;
  }
  .hb-scd__gallery figcaption {
    margin-top: 6px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--hb-ink-mute);
  }

  .hb-scd__flow,
  .hb-scd__haptics {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--hb-ink-soft);
  }
  .hb-scd__flow {
    counter-reset: flow;
  }
  .hb-scd__flow li,
  .hb-scd__haptics li {
    position: relative;
    margin: 0;
    padding-left: 34px;
  }
  .hb-scd__flow li::before {
    counter-increment: flow;
    content: counter(flow);
    position: absolute;
    left: 0;
    top: 1px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: oklch(0.98 0.01 var(--_hue));
    background: oklch(0.55 0.13 var(--_hue));
  }
  .hb-scd__haptics li::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0.55em;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    border: 2px solid oklch(0.55 0.13 var(--_hue));
    box-shadow: 0 0 0 4px oklch(0.55 0.13 var(--_hue) / 0.18);
  }

  /* 機材・人数など: 目立たせない控えめな表 */
  .hb-scd__specs {
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    padding: 12px 16px;
    border-radius: var(--hb-radius);
    background: var(--hb-bg-soft);
    font-size: 13px;
    line-height: 1.6;
  }
  .hb-scd__specs div {
    display: flex;
    gap: 8px;
  }
  .hb-scd__specs dt {
    font-weight: 700;
    color: var(--hb-ink-mute);
    white-space: nowrap;
  }
  .hb-scd__specs dd {
    margin: 0;
    color: var(--hb-ink-soft);
  }

  .hb-scd__others {
    margin-top: 36px;
  }
  .hb-scd .hb-scd__others h2 {
    margin: 0 0 12px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: normal;
    color: var(--hb-ink);
  }
  .hb-scd .hb-scd__others h2::before {
    content: none;
  }
  .hb-scd__others ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 160px), 1fr));
    gap: 14px;
  }
  .hb-scd__others li {
    margin: 0;
  }
  .hb-scd__others a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    color: var(--hb-ink);
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
  }
  .hb-scd__others a :global(.hb-sc-thumb) {
    border-radius: var(--hb-radius);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .hb-scd__others a:hover :global(.hb-sc-thumb) {
    transform: translateY(-2px);
    box-shadow: var(--hb-shadow-md);
  }

  @media (max-width: 50rem) {
    .hb-scd__top {
      grid-template-columns: 1fr;
    }
  }
</style>
