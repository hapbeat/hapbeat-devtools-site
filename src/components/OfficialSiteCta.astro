---
/**
 * OfficialSiteCta — デモ一覧 (/demos/showcase/) から公式サイトへの導線。
 *
 * デモ一覧は展示会の出展フォーム等で外部に共有する入口になるため、
 * 体験後に「製品を見る / 借りて試す / 相談する」へそのまま進めるようにする。
 * 貸出フォームは hapbeat.com の「試す・体験」節と同じもの (個人・法人向けの無償貸出)。
 */
const LINKS = [
  {
    href: 'https://hapbeat.com/products/',
    label: '製品を見る',
    note: 'ラインナップと仕様',
    primary: true,
  },
  {
    href: 'https://forms.gle/KDQ4aFjyGcqxD7rV8',
    label: '無償貸出を申し込む',
    note: '個人・法人どなたでも',
  },
  {
    href: 'https://hapbeat.com/contact/',
    label: 'お問い合わせ',
    note: '導入・展示のご相談',
  },
];
---

<section class="hb-osc" aria-labelledby="hb-osc-title">
  <div class="hb-osc__text">
    <h2 id="hb-osc-title" class="hb-osc__title">Hapbeat を導入・体験したい方へ</h2>
    <p class="hb-osc__lead">
      製品情報・購入・貸出・お問い合わせは
      <a href="https://hapbeat.com/" target="_blank" rel="noopener noreferrer">Hapbeat 公式サイト（hapbeat.com）</a>
      にまとまっています。
    </p>
  </div>
  <ul class="hb-osc__links">
    {
      LINKS.map((l) => (
        <li>
          <a
            class:list={['hb-osc__btn', { 'hb-osc__btn--primary': l.primary }]}
            href={l.href}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="hb-osc__label">
              {l.label}
              <svg viewBox="0 0 14 14" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="9" x2="13" y2="1" />
                <polyline points="8.5,1 13,1 13,5.5" />
                <path d="M7,1.5 H2.5 C1.67,1.5 1,2.17 1,3 V11.5 C1,12.33 1.67,13 2.5,13 H11.5 C12.33,13 13,12.33 13,11.5 V8" />
              </svg>
            </span>
            <span class="hb-osc__note">{l.note}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hb-osc {
    display: grid;
    gap: 16px;
    margin: 8px 0 32px;
    padding: 22px 24px;
    border: 1px solid var(--hb-line-strong);
    border-radius: var(--hb-radius-lg);
    background: var(--hb-bg-elev);
  }
  /* サイト共通の h2 余白 (margin-top 大) を打ち消すため詳細度を上げる */
  .hb-osc .hb-osc__title {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--hb-ink);
  }
  .hb-osc__lead {
    margin: 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--hb-ink-soft);
  }
  .hb-osc__lead a {
    color: var(--hb-purple-ink);
    font-weight: 600;
  }
  .hb-osc__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hb-osc__btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    min-height: 56px;
    padding: 8px 18px;
    border: 1px solid var(--hb-line-strong);
    border-radius: 12px;
    background: var(--hb-bg);
    color: var(--hb-ink) !important;
    text-decoration: none !important;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }
  .hb-osc__btn:hover {
    border-color: var(--hb-ink-mute);
  }
  .hb-osc__btn--primary {
    background: var(--hb-ink);
    border-color: var(--hb-ink);
    color: var(--hb-bg-elev) !important;
  }
  .hb-osc__btn--primary:hover {
    filter: brightness(1.15);
  }
  .hb-osc__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
  }
  .hb-osc__note {
    font-size: 12px;
    opacity: 0.75;
    white-space: nowrap;
  }

  @media (max-width: 36rem) {
    .hb-osc {
      padding: 18px 16px;
    }
    .hb-osc__links li {
      flex: 1 1 100%;
    }
  }
</style>
