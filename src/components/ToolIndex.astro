---
/**
 * ToolIndex
 *
 * /tools/ の一覧。DemoCard 系（角丸カード + 上部アクセントライン + アイコンタイル
 * + ピル）とは意図的に別物にしてある。あちらは「遊べるデモ」の賑やかさが目的だが、
 * こちらは道具棚で、探して開くのが唯一の用事なので装飾は要らない。
 *
 * 参考にした実物 (2026-08-10 閲覧):
 *   - https://esphome.io/projects/        カード無し。見出し + 説明の素の文字組み
 *   - https://tools.simonwillison.net/    「名前 — 一言」の並びだけ。箱も影も無い
 * どちらも共通して「一覧そのものがデザイン」で、囲みを持たない。
 *
 * したがって箱は使わず、罫線で区切るだけにする。角丸・影・グラデーション・
 * 絵文字タイル・バッジはいずれも無し（角丸とアクセントの併用は避ける方針）。
 * 情報の優先順位は 名前 > 説明 > 動作条件 の 3 段で、字送りと色だけで表す。
 *
 * Props:
 *   - items: 一覧に出すツール
 *       name        表示名（リンク）
 *       href        リンク先
 *       description 一行の説明
 *       meta        動作条件など（任意。例 "Chrome / Edge"）
 */
interface Item {
  name: string;
  href: string;
  description: string;
  meta?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ul class="tool-index">
  {
    items.map((item) => (
      <li class="tool-index__item">
        <a class="tool-index__name" href={item.href}>
          {item.name}
        </a>
        <p class="tool-index__desc">{item.description}</p>
        {item.meta && <p class="tool-index__meta">{item.meta}</p>}
      </li>
    ))
  }
</ul>

<style>
  .tool-index {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .tool-index__item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .tool-index__name {
    font-size: var(--sl-text-xl);
    font-weight: 600;
    text-decoration: none;
    color: var(--sl-color-white);
  }
  /* 下線は hover のときだけ。並んでいる状態では名前の連なりが読みやすい方がよい。 */
  .tool-index__name:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .tool-index__desc {
    margin: 0.35rem 0 0;
    color: var(--sl-color-gray-2);
  }

  .tool-index__meta {
    margin: 0.25rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
