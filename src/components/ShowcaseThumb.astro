---
/**
 * ShowcaseThumb — /demos/showcase/ のサムネイル (16:9)。
 *
 * size='hero' (詳細ページ上部) は video > thumbnail > プレースホルダ、
 * size='card' (一覧) は thumbnail > video > プレースホルダ の順で表示する
 * (一覧で何本も動画を自動再生させない)。動画は無音 (muted) でループ自動再生し、
 * thumbnail をポスターに使う。素材が無いデモは、デモごとの色相 (hue) の単色面に
 * 絵文字とタイトルを載せたプレースホルダにする。
 * 素材の指定は src/data/showcase.ts の 1 か所だけ。
 * 画像はサイト共通の本文画像スタイル (枠・角丸・影) を class="bare" で外し、
 * 角の丸めは親 (カード等) の overflow: hidden に任せる。
 *
 * サイトの ClientRouter でページを差し替えると、入れ替わった <video> は再生直後に
 * 止まる。そのため動画のある詳細ページへのリンク (ShowcaseCard・前後移動) は
 * data-astro-reload で通常の読み込みにしている。動きを減らす設定
 * (prefers-reduced-motion) の端末では自動再生せず、操作バーで再生してもらう。
 *
 * Props:
 *   - demo: ShowcaseDemo
 *   - size: 'card' | 'hero'
 */
import type { ShowcaseDemo } from '../data/showcase';

interface Props {
  demo: ShowcaseDemo;
  size?: 'card' | 'hero';
}

const { demo, size = 'card' } = Astro.props;
const showVideo = demo.video && (size === 'hero' || !demo.thumbnail);
---

<div class="hb-sc-thumb" data-size={size} style={`--_hue: ${demo.hue}`}>
  {
    showVideo ? (
      <video src={demo.video} poster={demo.thumbnail} muted autoplay loop playsinline controls preload="metadata" aria-label={`${demo.title} の紹介動画`} data-sc-autoplay />
    ) : demo.thumbnail ? (
      <img class="bare" src={demo.thumbnail} alt={demo.title} loading="lazy" decoding="async" />
    ) : (
      <div class="hb-sc-thumb__ph" aria-hidden="true">
        <span class="hb-sc-thumb__icon">{demo.icon}</span>
        <span class="hb-sc-thumb__title">{demo.title}</span>
      </div>
    )
  }
</div>

<script>
  function startShowcaseVideos() {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll<HTMLVideoElement>('video[data-sc-autoplay]').forEach((v) => {
      v.muted = true;
      if (reduce) {
        v.autoplay = false;
        v.pause();
      } else if (v.paused) {
        v.play().catch(() => {});
      }
    });
  }
  document.addEventListener('astro:page-load', startShowcaseVideos);
</script>

<style>
  .hb-sc-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: oklch(0.9 0.06 var(--_hue));
  }
  :global([data-theme='dark']) .hb-sc-thumb {
    background: oklch(0.32 0.08 var(--_hue));
  }
  .hb-sc-thumb img,
  .hb-sc-thumb video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: none;
    margin: 0;
    object-fit: cover;
  }

  .hb-sc-thumb__ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 12px;
    text-align: center;
    background:
      radial-gradient(90% 120% at 85% 0%, oklch(0.96 0.05 var(--_hue) / 0.9) 0%, transparent 60%),
      linear-gradient(160deg, oklch(0.88 0.08 var(--_hue)) 0%, oklch(0.8 0.11 var(--_hue)) 100%);
    color: oklch(0.3 0.09 var(--_hue));
  }
  :global([data-theme='dark']) .hb-sc-thumb__ph {
    background:
      radial-gradient(90% 120% at 85% 0%, oklch(0.5 0.12 var(--_hue) / 0.55) 0%, transparent 60%),
      linear-gradient(160deg, oklch(0.36 0.09 var(--_hue)) 0%, oklch(0.26 0.07 var(--_hue)) 100%);
    color: oklch(0.93 0.05 var(--_hue));
  }
  .hb-sc-thumb__icon {
    font-size: 40px;
    line-height: 1;
  }
  .hb-sc-thumb__title {
    font-size: 18px;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-wrap: balance;
  }
  .hb-sc-thumb[data-size='hero'] .hb-sc-thumb__icon {
    font-size: clamp(48px, 9vw, 88px);
  }
  .hb-sc-thumb[data-size='hero'] .hb-sc-thumb__title {
    font-size: clamp(22px, 3.6vw, 36px);
  }
</style>
