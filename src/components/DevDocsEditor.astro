---
interface Props { pathname: string; }
const { pathname } = Astro.props;
const isDocumentationPage = pathname.startsWith('/docs/') || pathname.startsWith('/en/docs/');
---

{isDocumentationPage && (
  <aside id="hb-local-docs-editor" data-path={pathname} aria-label="Local document tools">
    <div class="hb-local-docs-editor__toolbar">
      <span>ローカル編集</span>
      <button type="button" data-hb-doc-editor-open>本文を編集</button>
      <button type="button" data-hb-doc-comment-open disabled>選択箇所にコメント</button>
      <span class="hb-local-docs-editor__hint" data-hb-doc-comment-hint>本文の文字列を選択してください</span>
    </div>
    <section class="hb-local-docs-editor__comments" data-hb-doc-comments hidden aria-label="Comments"></section>

    <dialog class="hb-local-docs-editor__dialog" data-hb-doc-editor-dialog>
      <div class="hb-local-docs-editor__panel">
        <header>
          <div><p>LOCAL DEVELOPMENT</p><h2>本文を編集</h2><small data-hb-doc-editor-path></small></div>
          <button type="button" data-hb-doc-editor-close aria-label="Close editor">×</button>
        </header>
        <div data-hb-doc-editor-host></div>
        <footer><span data-hb-doc-editor-status aria-live="polite"></span><div><button type="button" data-hb-doc-editor-cancel>キャンセル</button><button type="button" data-hb-doc-editor-save disabled>保存して再読み込み</button></div></footer>
      </div>
    </dialog>

    <dialog class="hb-local-docs-editor__comment-dialog" data-hb-doc-comment-dialog>
      <form method="dialog" class="hb-local-docs-editor__comment-panel">
        <header><div><p>COMMENT</p><h2>選択箇所にコメント</h2><blockquote data-hb-doc-comment-selection></blockquote></div><button type="submit" aria-label="Close comment">×</button></header>
        <textarea data-hb-doc-comment-textarea placeholder="例: この文を短くしたい。別の文案を提案してから変更してほしい。"></textarea>
        <footer><span data-hb-doc-comment-status aria-live="polite"></span><div><button type="button" data-hb-doc-comment-cancel>キャンセル</button><button type="button" data-hb-doc-comment-save>コメントを保存</button></div></footer>
      </form>
    </dialog>
  </aside>
)}

<style is:global>
  #hb-local-docs-editor { margin: 0 0 1.5rem; }
  .hb-local-docs-editor__toolbar, .hb-local-docs-editor__comments { border: 1px solid color-mix(in srgb, var(--sl-color-accent) 45%, var(--sl-color-gray-5)); border-radius: .5rem; }
  .hb-local-docs-editor__toolbar { align-items: center; background: color-mix(in srgb, var(--sl-color-accent) 12%, var(--sl-color-bg)); display: flex; flex-wrap: wrap; gap: .55rem; padding: .6rem .75rem; }
  .hb-local-docs-editor__toolbar > span:first-child { font-size: .8rem; font-weight: 700; }
  .hb-local-docs-editor__hint { color: var(--sl-color-gray-2); font-size: .78rem; }
  .hb-local-docs-editor__toolbar button, .hb-local-docs-editor__panel button, .hb-local-docs-editor__comment-panel button { border: 1px solid var(--sl-color-gray-5); border-radius: .35rem; background: var(--sl-color-gray-6); color: var(--sl-color-text); cursor: pointer; font: inherit; padding: .4rem .65rem; }
  [data-hb-doc-editor-open], [data-hb-doc-editor-save], [data-hb-doc-comment-save] { background: var(--sl-color-accent) !important; color: var(--sl-color-text-invert) !important; }
  button:disabled { cursor: not-allowed; opacity: .55; }
  .hb-local-docs-editor__comments { margin-top: .5rem; padding: .75rem; }
  .hb-local-docs-editor__comments h3 { font-size: .9rem; margin: 0 0 .45rem; }
  .hb-local-docs-editor__comments ol { margin: 0; padding-left: 1.25rem; }
  .hb-local-docs-editor__comments li { margin: .35rem 0; }
  .hb-local-docs-editor__comments button { background: transparent; border: 0; color: var(--sl-color-accent); cursor: pointer; font: inherit; padding: 0; text-align: left; }
  .hb-local-docs-editor__dialog, .hb-local-docs-editor__comment-dialog { border: 1px solid var(--sl-color-gray-5); border-radius: .75rem; background: var(--sl-color-bg); color: var(--sl-color-text); box-shadow: 0 24px 80px rgb(0 0 0 / 45%); padding: 0; width: min(72rem, calc(100vw - 2rem)); }
  .hb-local-docs-editor__dialog { height: min(48rem, calc(100vh - 2rem)); }
  .hb-local-docs-editor__comment-dialog { max-width: 48rem; }
  .hb-local-docs-editor__dialog::backdrop, .hb-local-docs-editor__comment-dialog::backdrop { background: rgb(0 0 0 / 62%); }
  .hb-local-docs-editor__panel { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; height: 100%; }
  .hb-local-docs-editor__panel header, .hb-local-docs-editor__panel footer, .hb-local-docs-editor__comment-panel header, .hb-local-docs-editor__comment-panel footer { align-items: center; display: flex; gap: 1rem; justify-content: space-between; padding: 1rem 1.25rem; }
  .hb-local-docs-editor__panel header, .hb-local-docs-editor__comment-panel header { border-bottom: 1px solid var(--sl-color-gray-5); }
  .hb-local-docs-editor__panel footer, .hb-local-docs-editor__comment-panel footer { border-top: 1px solid var(--sl-color-gray-5); }
  .hb-local-docs-editor__panel h2, .hb-local-docs-editor__comment-panel h2, .hb-local-docs-editor__panel p, .hb-local-docs-editor__comment-panel p { margin: 0; }
  .hb-local-docs-editor__panel header p, .hb-local-docs-editor__comment-panel header p { color: var(--sl-color-accent); font-size: .7rem; font-weight: 700; letter-spacing: .08em; }
  [data-hb-doc-editor-host] { min-height: 0; overflow: auto; }
  [data-hb-doc-editor-host] .toastui-editor-defaultUI { border: 0; height: 100% !important; }
  [data-hb-doc-editor-host] .toastui-editor-toolbar { border-bottom-color: var(--sl-color-gray-5); }
  [data-hb-doc-comment-selection] { border-left: 3px solid var(--sl-color-accent); color: var(--sl-color-gray-2); font-size: .9rem; margin: 1rem 1.25rem; padding-left: .75rem; }
  [data-hb-doc-comment-textarea] { background: var(--sl-color-black); border: 0; box-sizing: border-box; color: var(--sl-color-white); display: block; font: .9rem/1.55 var(--sl-font-mono); min-height: 12rem; padding: 1rem 1.25rem; resize: vertical; width: 100%; }
  mark.hb-doc-comment { background: color-mix(in srgb, var(--sl-color-accent) 35%, transparent); border-bottom: 2px solid var(--sl-color-accent); cursor: pointer; }
  @media (max-width: 42rem) { .hb-local-docs-editor__panel footer, .hb-local-docs-editor__comment-panel footer { align-items: flex-start; flex-direction: column; } }
</style>

<script>
  type Comment = { id: string; selection: string; message: string; createdAt: string };
  type Source = { hash: string; sourcePath: string; editorContent: string; comments: Comment[] };
  type ToastEditor = { getMarkdown: () => string; destroy: () => void };

  function bindEditor() {
    const root = document.getElementById('hb-local-docs-editor');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';
    const pagePath = root.dataset.path;
    const content = document.querySelector<HTMLElement>('.sl-markdown-content');
    const editOpen = root.querySelector<HTMLButtonElement>('[data-hb-doc-editor-open]');
    const editDialog = root.querySelector<HTMLDialogElement>('[data-hb-doc-editor-dialog]');
    const editorHost = root.querySelector<HTMLElement>('[data-hb-doc-editor-host]');
    const editPath = root.querySelector<HTMLElement>('[data-hb-doc-editor-path]');
    const editStatus = root.querySelector<HTMLElement>('[data-hb-doc-editor-status]');
    const editSave = root.querySelector<HTMLButtonElement>('[data-hb-doc-editor-save]');
    const commentOpen = root.querySelector<HTMLButtonElement>('[data-hb-doc-comment-open]');
    const commentHint = root.querySelector<HTMLElement>('[data-hb-doc-comment-hint]');
    const commentDialog = root.querySelector<HTMLDialogElement>('[data-hb-doc-comment-dialog]');
    const commentSelection = root.querySelector<HTMLElement>('[data-hb-doc-comment-selection]');
    const commentText = root.querySelector<HTMLTextAreaElement>('[data-hb-doc-comment-textarea]');
    const commentStatus = root.querySelector<HTMLElement>('[data-hb-doc-comment-status]');
    const commentSave = root.querySelector<HTMLButtonElement>('[data-hb-doc-comment-save]');
    const commentsBox = root.querySelector<HTMLElement>('[data-hb-doc-comments]');
    if (!pagePath || !content || !editOpen || !editDialog || !editorHost || !editPath || !editStatus || !editSave || !commentOpen || !commentHint || !commentDialog || !commentSelection || !commentText || !commentStatus || !commentSave || !commentsBox) return;

    const endpoint = () => { const url = new URL('/__hapbeat/docs-editor', location.origin); url.searchParams.set('path', pagePath); return url; };
    const getSource = async (): Promise<Source> => { const response = await fetch(endpoint()); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || 'Could not load this page.'); return data; };
    const post = async (body: object) => { const response = await fetch(endpoint(), { method: 'POST', headers: { 'content-type': 'application/json; charset=utf-8' }, body: JSON.stringify(body) }); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || 'Could not save this page.'); return data; };
    let source: Source | null = null;
    let editor: ToastEditor | null = null;
    let selectedText = '';

    function updateSelection() {
      const selection = window.getSelection();
      const text = selection?.toString().trim() || '';
      const range = selection?.rangeCount ? selection.getRangeAt(0) : null;
      const isInContent = Boolean(range && content.contains(range.commonAncestorContainer));
      selectedText = isInContent ? text : '';
      commentOpen.disabled = !selectedText;
      commentHint.textContent = selectedText ? `選択中: ${selectedText.slice(0, 60)}${selectedText.length > 60 ? '…' : ''}` : '本文の文字列を選択してください';
    }

    function highlightComments(comments: Comment[]) {
      commentsBox.replaceChildren();
      if (comments.length === 0) { commentsBox.hidden = true; return; }
      const heading = document.createElement('h3'); heading.textContent = `コメント (${comments.length})`;
      const list = document.createElement('ol');
      comments.forEach((comment) => {
        const item = document.createElement('li'); const button = document.createElement('button');
        button.textContent = `「${comment.selection}」— ${comment.message}`;
        button.addEventListener('click', () => document.querySelector(`[data-hb-doc-comment-id="${CSS.escape(comment.id)}"]`)?.scrollIntoView({ block: 'center', behavior: 'smooth' }));
        const remove = document.createElement('button'); remove.textContent = '削除'; remove.className = 'hb-doc-comment-remove';
        remove.addEventListener('click', async () => {
          try { const latest = await getSource(); await post({ removeCommentId: comment.id, hash: latest.hash }); location.reload(); }
          catch { remove.textContent = '削除できませんでした'; }
        });
        item.append(button, document.createTextNode(' '), remove); list.append(item);
        const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT);
        let node: Text | null;
        while ((node = walker.nextNode() as Text | null)) {
          const index = node.data.indexOf(comment.selection);
          if (index < 0 || node.parentElement?.closest('mark.hb-doc-comment')) continue;
          const fragment = document.createDocumentFragment();
          fragment.append(node.data.slice(0, index));
          const mark = document.createElement('mark'); mark.className = 'hb-doc-comment'; mark.dataset.hbDocCommentId = comment.id; mark.title = comment.message; mark.textContent = comment.selection;
          mark.addEventListener('click', () => alert(comment.message));
          fragment.append(mark, node.data.slice(index + comment.selection.length)); node.replaceWith(fragment); break;
        }
      });
      commentsBox.append(heading, list); commentsBox.hidden = false;
    }

    async function initializeComments() { try { highlightComments((await getSource()).comments); } catch {} }

    editOpen.addEventListener('click', async () => {
      editOpen.disabled = true; editStatus.textContent = 'Loading…';
      try {
        source = await getSource(); editPath.textContent = source.sourcePath;
        await import('@toast-ui/editor/dist/toastui-editor.css');
        const { default: Editor } = await import('@toast-ui/editor');
        editor?.destroy(); editorHost.replaceChildren();
        editor = new Editor({ el: editorHost, height: '100%', initialValue: source.editorContent, initialEditType: 'wysiwyg', hideModeSwitch: true, usageStatistics: false, toolbarItems: [['heading', 'bold', 'italic', 'strike'], ['hr', 'quote'], ['ul', 'ol', 'task'], ['table', 'link'], ['code', 'codeblock']] });
        editSave.disabled = false; editStatus.textContent = '見たまま編集し、保存すると Markdown として反映されます。'; editDialog.showModal();
      } catch (error) { editStatus.textContent = error instanceof Error ? error.message : 'Could not open the editor.'; }
      finally { editOpen.disabled = false; }
    });
    editSave.addEventListener('click', async () => {
      if (!source || !editor) return; editSave.disabled = true; editStatus.textContent = 'Saving…';
      try { await post({ content: editor.getMarkdown(), hash: source.hash }); editStatus.textContent = '保存しました。再読み込みしています…'; setTimeout(() => location.reload(), 500); }
      catch (error) { editStatus.textContent = error instanceof Error ? error.message : 'Could not save this page.'; editSave.disabled = false; }
    });
    root.querySelector('[data-hb-doc-editor-close]')?.addEventListener('click', () => editDialog.close());
    root.querySelector('[data-hb-doc-editor-cancel]')?.addEventListener('click', () => editDialog.close());

    document.addEventListener('selectionchange', updateSelection);
    commentOpen.addEventListener('mousedown', (event) => event.preventDefault());
    commentOpen.addEventListener('click', async () => {
      if (!selectedText) return; commentStatus.textContent = 'Loading…'; commentSelection.textContent = selectedText;
      try { source = await getSource(); commentDialog.showModal(); commentText.focus(); commentStatus.textContent = ''; }
      catch (error) { commentStatus.textContent = error instanceof Error ? error.message : 'Could not open comments.'; }
    });
    commentSave.addEventListener('click', async () => {
      if (!source || !selectedText || !commentText.value.trim()) return; commentSave.disabled = true; commentStatus.textContent = 'Saving…';
      try { await post({ comment: { selection: selectedText, message: commentText.value.trim() }, hash: source.hash }); commentStatus.textContent = '保存しました。再読み込みしています…'; setTimeout(() => location.reload(), 500); }
      catch (error) { commentStatus.textContent = error instanceof Error ? error.message : 'Could not save this comment.'; commentSave.disabled = false; }
    });
    root.querySelector('[data-hb-doc-comment-cancel]')?.addEventListener('click', () => commentDialog.close());
    initializeComments();
  }
  bindEditor();
  if (!window.__hbDocsEditorNavigationBound) { window.__hbDocsEditorNavigationBound = true; document.addEventListener('astro:after-swap', bindEditor); }
</script>
