---
interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
const isDocumentationPage = pathname.startsWith('/docs/') || pathname.startsWith('/en/docs/');
---

{
  isDocumentationPage && (
    <aside id="hb-local-docs-editor" data-path={pathname} aria-label="Local document editor">
      <button type="button" class="hb-local-docs-editor__open" data-hb-doc-editor-open>
        Edit this page
      </button>
      <dialog class="hb-local-docs-editor__dialog" data-hb-doc-editor-dialog>
        <form method="dialog" class="hb-local-docs-editor__panel">
          <header>
            <div>
              <p class="hb-local-docs-editor__eyebrow">LOCAL DEVELOPMENT</p>
              <h2>Edit Markdown</h2>
              <p data-hb-doc-editor-path>Loading source…</p>
            </div>
            <button type="submit" aria-label="Close editor">×</button>
          </header>
          <textarea data-hb-doc-editor-textarea spellcheck="false" aria-label="Markdown source"></textarea>
          <footer>
            <p data-hb-doc-editor-status aria-live="polite"></p>
            <div>
              <button type="button" data-hb-doc-editor-cancel>Cancel</button>
              <button type="button" data-hb-doc-editor-save disabled>Save and reload</button>
            </div>
          </footer>
        </form>
      </dialog>
    </aside>
  )
}

<style is:global>
  #hb-local-docs-editor {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
  }
  .hb-local-docs-editor__open {
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 72%, white);
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-invert);
    box-shadow: 0 8px 24px rgb(0 0 0 / 25%);
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    padding: 0.55rem 0.85rem;
  }
  .hb-local-docs-editor__open:hover { filter: brightness(1.12); }
  .hb-local-docs-editor__dialog {
    width: min(72rem, calc(100vw - 2rem));
    height: min(48rem, calc(100vh - 2rem));
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    box-shadow: 0 24px 80px rgb(0 0 0 / 45%);
    padding: 0;
  }
  .hb-local-docs-editor__dialog::backdrop { background: rgb(0 0 0 / 62%); }
  .hb-local-docs-editor__panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    box-sizing: border-box;
    height: 100%;
    margin: 0;
  }
  .hb-local-docs-editor__panel header,
  .hb-local-docs-editor__panel footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }
  .hb-local-docs-editor__panel header { border-bottom: 1px solid var(--sl-color-gray-5); }
  .hb-local-docs-editor__panel footer { border-top: 1px solid var(--sl-color-gray-5); }
  .hb-local-docs-editor__panel h2,
  .hb-local-docs-editor__panel p { margin: 0; }
  .hb-local-docs-editor__panel h2 { font-size: 1.1rem; }
  .hb-local-docs-editor__eyebrow {
    color: var(--sl-color-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }
  [data-hb-doc-editor-path], [data-hb-doc-editor-status] {
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }
  [data-hb-doc-editor-textarea] {
    box-sizing: border-box;
    width: 100%;
    min-height: 0;
    resize: none;
    border: 0;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font: 0.85rem/1.55 var(--sl-font-mono);
    padding: 1rem 1.25rem;
  }
  [data-hb-doc-editor-textarea]:focus { outline: 2px solid var(--sl-color-accent); outline-offset: -2px; }
  .hb-local-docs-editor__panel button {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.35rem;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    cursor: pointer;
    font: inherit;
    padding: 0.4rem 0.65rem;
  }
  .hb-local-docs-editor__panel footer > div { display: flex; gap: 0.5rem; }
  [data-hb-doc-editor-save] { background: var(--sl-color-accent) !important; color: var(--sl-color-text-invert) !important; }
  [data-hb-doc-editor-save]:disabled { cursor: wait; opacity: 0.55; }
  @media (max-width: 42rem) {
    #hb-local-docs-editor { right: 0.75rem; bottom: 0.75rem; }
    .hb-local-docs-editor__panel footer { align-items: flex-start; flex-direction: column; }
  }
</style>

<script>
  type EditorState = { hash: string | null; loaded: boolean };

  function bindEditor() {
    const root = document.getElementById('hb-local-docs-editor');
    if (!root || root.dataset.hbDocsEditorBound === '1') return;
    root.dataset.hbDocsEditorBound = '1';

    const path = root.dataset.path;
    const openButton = root.querySelector<HTMLButtonElement>('[data-hb-doc-editor-open]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-hb-doc-editor-dialog]');
    const textarea = root.querySelector<HTMLTextAreaElement>('[data-hb-doc-editor-textarea]');
    const sourcePath = root.querySelector<HTMLElement>('[data-hb-doc-editor-path]');
    const status = root.querySelector<HTMLElement>('[data-hb-doc-editor-status]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-hb-doc-editor-save]');
    const cancelButton = root.querySelector<HTMLButtonElement>('[data-hb-doc-editor-cancel]');
    if (!path || !openButton || !dialog || !textarea || !sourcePath || !status || !saveButton || !cancelButton) return;

    const state: EditorState = { hash: null, loaded: false };
    const endpoint = () => {
      const url = new URL('/__hapbeat/docs-editor', window.location.origin);
      url.searchParams.set('path', path);
      return url;
    };
    const setStatus = (message: string) => { status.textContent = message; };

    async function load() {
      openButton.disabled = true;
      setStatus('Loading…');
      try {
        const response = await fetch(endpoint());
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Could not open this page.');
        textarea.value = result.content;
        sourcePath.textContent = result.sourcePath;
        state.hash = result.hash;
        state.loaded = true;
        saveButton.disabled = false;
        setStatus('Edit the source, then save to reload this page.');
        dialog.showModal();
        textarea.focus();
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not open this page.');
      } finally {
        openButton.disabled = false;
      }
    }

    async function save() {
      if (!state.loaded || !state.hash) return;
      saveButton.disabled = true;
      setStatus('Saving…');
      try {
        const response = await fetch(endpoint(), {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ content: textarea.value, hash: state.hash }),
        });
        const result = await response.json();
        if (!response.ok || !result.ok) throw new Error(result.error || 'Could not save this page.');
        setStatus('Saved. Reloading…');
        window.setTimeout(() => window.location.reload(), 500);
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'Could not save this page.');
        saveButton.disabled = false;
      }
    }

    openButton.addEventListener('click', load);
    saveButton.addEventListener('click', save);
    cancelButton.addEventListener('click', () => dialog.close());
    textarea.addEventListener('keydown', (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 's') {
        event.preventDefault();
        void save();
      }
    });
  }

  bindEditor();
  if (!window.__hbDocsEditorNavigationBound) {
    window.__hbDocsEditorNavigationBound = true;
    document.addEventListener('astro:after-swap', bindEditor);
  }
</script>
