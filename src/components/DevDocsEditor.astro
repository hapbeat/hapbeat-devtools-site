---
interface Props { pathname: string; }
const { pathname } = Astro.props;
const isDocumentationPage = pathname.startsWith('/docs/') || pathname.startsWith('/en/docs/');
---

{isDocumentationPage && (
  <div id="hb-local-docs-editor" data-path={pathname} contenteditable="false" aria-label="Local document editor">
    <button class="hb-doc-status" type="button" data-hb-doc-status data-state="loading" aria-live="polite">ローカル編集を準備中…</button>
    <div class="hb-doc-bubble" data-hb-doc-bubble hidden role="toolbar" aria-label="Selected text actions">
      <button type="button" data-hb-comment-open aria-label="Add comment">コメント</button>
    </div>
    <section class="hb-doc-popover hb-doc-comment-compose" data-hb-comment-compose hidden aria-label="Add comment">
      <blockquote data-hb-comment-selection></blockquote>
      <textarea data-hb-comment-text placeholder="この箇所へのコメント"></textarea>
      <footer><button type="button" data-hb-comment-cancel>キャンセル</button><button type="button" data-hb-comment-save>保存</button></footer>
      <p data-hb-comment-error aria-live="polite"></p>
    </section>
    <section class="hb-doc-popover hb-doc-comments" data-hb-comments hidden aria-label="Comments">
      <header><strong data-hb-comments-title>コメント</strong><button type="button" data-hb-comments-close aria-label="Close">×</button></header>
      <ol data-hb-comments-list></ol>
    </section>
  </div>
)}

<style is:global>
  #hb-local-docs-editor { position: fixed; right: 1rem; top: calc(var(--sl-nav-height) + .75rem); z-index: 80; }
  .hb-doc-status { background: color-mix(in srgb, var(--sl-color-bg-nav) 92%, transparent); border: 1px solid var(--sl-color-gray-5); border-radius: 999px; box-shadow: 0 6px 24px rgb(0 0 0 / 16%); color: var(--sl-color-gray-2); cursor: pointer; font: 600 .72rem/1 var(--sl-font); padding: .5rem .7rem; }
  .hb-doc-status[data-state="editing"] { border-color: var(--sl-color-accent); color: var(--sl-color-accent-high); }
  .hb-doc-status[data-state="saving"] { color: var(--sl-color-orange-high); }
  .hb-doc-status[data-state="error"] { border-color: var(--sl-color-red); color: var(--sl-color-red-high); }
  .hb-doc-bubble, .hb-doc-popover { background: color-mix(in srgb, var(--sl-color-bg-nav) 96%, transparent); border: 1px solid var(--sl-color-gray-5); box-shadow: 0 12px 36px rgb(0 0 0 / 28%); color: var(--sl-color-text); position: fixed; z-index: 90; }
  .hb-doc-bubble { align-items: center; border-radius: .5rem; display: flex; gap: .15rem; padding: .25rem; }
  .hb-doc-bubble[hidden], .hb-doc-popover[hidden] { display: none; }
  .hb-doc-bubble button, .hb-doc-popover button { background: transparent; border: 0; border-radius: .3rem; color: inherit; cursor: pointer; font: 600 .76rem/1 var(--sl-font); min-height: 1.85rem; padding: .4rem .55rem; }
  .hb-doc-bubble button:hover, .hb-doc-popover button:hover { background: var(--sl-color-gray-6); }
  .hb-doc-popover { border-radius: .65rem; max-height: min(32rem, calc(100vh - 5rem)); overflow: auto; padding: .75rem; width: min(24rem, calc(100vw - 2rem)); }
  .hb-doc-comment-compose blockquote { border-left: 2px solid var(--sl-color-accent); color: var(--sl-color-gray-2); font-size: .8rem; margin: 0 0 .65rem; max-height: 6rem; overflow: auto; padding-left: .55rem; }
  .hb-doc-comment-compose textarea { background: var(--sl-color-bg); border: 1px solid var(--sl-color-gray-5); border-radius: .4rem; box-sizing: border-box; color: var(--sl-color-text); font: .85rem/1.5 var(--sl-font); min-height: 6rem; padding: .6rem; resize: vertical; width: 100%; }
  .hb-doc-comment-compose footer { display: flex; gap: .35rem; justify-content: flex-end; margin-top: .45rem; }
  .hb-doc-comment-compose [data-hb-comment-save] { background: var(--sl-color-accent); color: var(--sl-color-text-invert); }
  .hb-doc-comment-compose [data-hb-comment-error] { color: var(--sl-color-red-high); font-size: .75rem; margin: .35rem 0 0; }
  .hb-doc-comments { right: 1rem; top: calc(var(--sl-nav-height) + 3.65rem); }
  .hb-doc-comments header { align-items: center; display: flex; justify-content: space-between; }
  .hb-doc-comments ol { margin: .5rem 0 0; padding-left: 1.25rem; }
  .hb-doc-comments li { font-size: .8rem; margin: .75rem 0; }
  .hb-doc-comments blockquote { border-left: 2px solid var(--sl-color-accent); color: var(--sl-color-gray-2); margin: 0 0 .25rem; padding-left: .45rem; }
  .hb-doc-comments p { margin: .2rem 0; }
  .hb-doc-comments [data-remove-comment] { color: var(--sl-color-accent-high); min-height: auto; padding: .2rem 0; }
  .sl-markdown-content[contenteditable="true"] { caret-color: var(--sl-color-accent-high); }
  .sl-markdown-content[contenteditable="true"]:focus { outline: none; }
  .sl-markdown-content[contenteditable="true"] [contenteditable="false"] { user-select: none; }
  .sl-markdown-content[contenteditable="true"] a { cursor: text; }
  ::highlight(hb-doc-comments) { background: color-mix(in srgb, var(--sl-color-accent) 24%, transparent); text-decoration: underline var(--sl-color-accent); }
  @media (max-width: 50rem) { #hb-local-docs-editor { top: calc(var(--sl-nav-height) + .5rem); } .hb-doc-status { font-size: .68rem; } }
</style>

<script>
  type Comment = { id: string; selection: string; message: string; createdAt: string };
  type Source = { hash: string; sourcePath: string; editorContent: string; comments: Comment[] };
  type SaveResult = { hash: string; sourcePath: string };

  function bindEditor() {
    const ui = document.getElementById('hb-local-docs-editor');
    if (!ui || ui.dataset.bound === '1') return;
    ui.dataset.bound = '1';
    const pagePath = ui.dataset.path;
    const content = ui.closest<HTMLElement>('.sl-markdown-content');
    const status = ui.querySelector<HTMLButtonElement>('[data-hb-doc-status]');
    const bubble = ui.querySelector<HTMLElement>('[data-hb-doc-bubble]');
    const compose = ui.querySelector<HTMLElement>('[data-hb-comment-compose]');
    const composeSelection = ui.querySelector<HTMLElement>('[data-hb-comment-selection]');
    const composeText = ui.querySelector<HTMLTextAreaElement>('[data-hb-comment-text]');
    const composeError = ui.querySelector<HTMLElement>('[data-hb-comment-error]');
    const comments = ui.querySelector<HTMLElement>('[data-hb-comments]');
    const commentsTitle = ui.querySelector<HTMLElement>('[data-hb-comments-title]');
    const commentsList = ui.querySelector<HTMLOListElement>('[data-hb-comments-list]');
    if (!pagePath || !content || !status || !bubble || !compose || !composeSelection || !composeText || !composeError || !comments || !commentsTitle || !commentsList) return;

    const controller = new AbortController();
    const endpoint = () => { const url = new URL('/__hapbeat/docs-editor', location.origin); url.searchParams.set('path', pagePath); return url; };
    const getSource = async (): Promise<Source> => { const response = await fetch(endpoint()); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || 'Could not load this page.'); return data; };
    const post = async (body: object): Promise<SaveResult> => { const response = await fetch(endpoint(), { method: 'POST', headers: { 'content-type': 'application/json; charset=utf-8' }, body: JSON.stringify(body) }); const data = await response.json(); if (!response.ok || !data.ok) throw new Error(data.error || 'Could not save this page.'); return data; };
    const setStatus = (message: string, state: string) => { status.textContent = message; status.dataset.state = state; };

    let source: Source | null = null;
    let sourceTitle = '';
    let lastSaved = '';
    let saveTimer: number | undefined;
    let saving: Promise<boolean> | null = null;
    let selectedRange: Range | null = null;
    let selectedText = '';
    let turndown: { turndown: (input: Node | string) => string; addRule: (key: string, rule: object) => void; use: (plugin: unknown) => void } | null = null;

    const positionNear = (element: HTMLElement, rect: DOMRect, offset = 8) => {
      element.hidden = false;
      const own = element.getBoundingClientRect();
      const left = Math.min(Math.max(8, rect.left + rect.width / 2 - own.width / 2), window.innerWidth - own.width - 8);
      const above = rect.top - own.height - offset;
      const top = above >= 8 ? above : Math.min(rect.bottom + offset, window.innerHeight - own.height - 8);
      element.style.left = `${Math.round(left)}px`;
      element.style.top = `${Math.round(Math.max(8, top))}px`;
    };

    function prepareClone() {
      const clone = content.cloneNode(true) as HTMLElement;
      clone.removeAttribute('contenteditable');
      clone.querySelector('#hb-local-docs-editor')?.remove();
      clone.querySelectorAll('[data-pagefind-meta], .sl-anchor-link, .copy, link, script').forEach((node) => node.remove());
      clone.querySelectorAll('[contenteditable]').forEach((node) => node.removeAttribute('contenteditable'));
      return clone;
    }

    function serialize() { if (!turndown) return ''; const body = turndown.turndown(prepareClone()).trim(); return sourceTitle ? `${sourceTitle}\n\n${body}`.trim() : body; }

    async function saveNow(): Promise<boolean> {
      window.clearTimeout(saveTimer);
      if (!source || !turndown) return false;
      if (saving) return saving;
      const markdown = serialize();
      if (markdown === lastSaved) return true;
      const pending = (async () => {
        setStatus('保存中…', 'saving');
        try { const result = await post({ content: markdown, hash: source?.hash }); if (source) source.hash = result.hash; lastSaved = markdown; setStatus('保存済み', 'saved'); return true; }
        catch (error) { setStatus(error instanceof Error ? error.message : '保存できませんでした。', 'error'); return false; }
      })();
      saving = pending;
      const saved = await pending;
      if (saving === pending) saving = null;
      if (saved && serialize() !== lastSaved) return saveNow();
      return saved;
    }

    function scheduleSave() { setStatus('編集中…', 'editing'); window.clearTimeout(saveTimer); saveTimer = window.setTimeout(() => void saveNow(), 800); }

    function updateBubble() {
      if (!source || !turndown || !compose.hidden) return;
      const selection = window.getSelection();
      const range = selection?.rangeCount ? selection.getRangeAt(0) : null;
      if (!range || range.collapsed || !content.contains(range.commonAncestorContainer) || ui.contains(range.commonAncestorContainer)) { bubble.hidden = true; selectedRange = null; selectedText = ''; return; }
      selectedText = selection?.toString().trim() || '';
      if (!selectedText) { bubble.hidden = true; return; }
      selectedRange = range.cloneRange();
      positionNear(bubble, range.getBoundingClientRect());
    }

    function restoreSelection() { if (!selectedRange) return; const selection = window.getSelection(); selection?.removeAllRanges(); selection?.addRange(selectedRange); }

    function showCommentHighlights(items: Comment[]) {
      const highlights = (CSS as typeof CSS & { highlights?: Map<string, unknown> }).highlights;
      if (!highlights || typeof Highlight === 'undefined') return;
      const ranges: Range[] = [];
      const walker = document.createTreeWalker(content, NodeFilter.SHOW_TEXT, { acceptNode(node) { return ui.contains(node) ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT; } });
      const nodes: Text[] = []; let all = '';
      while (walker.nextNode()) { const node = walker.currentNode as Text; nodes.push(node); all += node.data; }
      const locate = (offset: number) => { let cursor = 0; for (const node of nodes) { if (offset <= cursor + node.length) return { node, offset: offset - cursor }; cursor += node.length; } return null; };
      items.forEach((item) => { const start = all.indexOf(item.selection); if (start < 0) return; const from = locate(start); const to = locate(start + item.selection.length); if (!from || !to) return; const range = document.createRange(); range.setStart(from.node, from.offset); range.setEnd(to.node, to.offset); ranges.push(range); });
      highlights.set('hb-doc-comments', new Highlight(...ranges));
    }

    function renderComments(items: Comment[]) {
      commentsList.replaceChildren(); commentsTitle.textContent = `コメント (${items.length})`;
      items.forEach((item) => { const li = document.createElement('li'); const quote = document.createElement('blockquote'); quote.textContent = item.selection; const message = document.createElement('p'); message.textContent = item.message; const remove = document.createElement('button'); remove.type = 'button'; remove.dataset.removeComment = item.id; remove.textContent = '削除'; li.append(quote, message, remove); commentsList.append(li); });
      showCommentHighlights(items);
    }

    async function initialize() {
      try {
        source = await getSource();
        sourceTitle = source.editorContent.match(/^#\s+[^\r\n]+/)?.[0] || '';
        const [{ default: TurndownService }, { gfm }] = await Promise.all([import('turndown'), import('turndown-plugin-gfm')]);
        const service = new TurndownService({ headingStyle: 'atx', bulletListMarker: '-', codeBlockStyle: 'fenced', emDelimiter: '*', strongDelimiter: '**' });
        service.use(gfm);
        service.addRule('hapbeatStyledInline', { filter: (node: Element) => (node.nodeName === 'SPAN' || node.nodeName === 'CODE') && [...node.classList].some((name) => name.startsWith('hb-')), replacement: (_content: string, node: Element) => node.outerHTML });
        service.addRule('starlightAside', { filter: (node: Element) => node.nodeName === 'ASIDE' && node.classList.contains('starlight-aside'), replacement: (_content: string, node: Element) => { const type = [...node.classList].find((name) => name.startsWith('starlight-aside--'))?.replace('starlight-aside--', '') || 'note'; const title = node.querySelector('.starlight-aside__title')?.textContent?.trim() || ''; const body = node.querySelector('.starlight-aside__content'); const inner = body ? service.turndown(body.innerHTML).trim() : ''; return `\n\n:::${type}${title ? `[${title}]` : ''}\n\n${inner}\n\n:::\n\n`; } });
        service.addRule('expressiveCode', { filter: (node: Element) => node.nodeName === 'DIV' && node.classList.contains('expressive-code'), replacement: (_content: string, node: Element) => { const pre = node.querySelector('pre'); const language = pre?.getAttribute('data-language') || ''; const lineNodes = [...node.querySelectorAll('.ec-line .code')]; const code = (lineNodes.length ? lineNodes.map((line) => line.textContent || '').join('\n') : pre?.textContent || '').replace(/\n$/, ''); const fence = code.includes('```') ? '````' : '```'; return `\n\n${fence}${language}\n${code}\n${fence}\n\n`; } });
        service.addRule('headingWrapper', { filter: (node: Element) => node.nodeName === 'DIV' && node.classList.contains('sl-heading-wrapper'), replacement: (inner: string) => `\n\n${inner.trim()}\n\n` });
        turndown = service;
        lastSaved = serialize();
        renderComments(source.comments);
        content.contentEditable = 'true'; content.spellcheck = true; ui.contentEditable = 'false';
        content.querySelectorAll('.sl-anchor-link, .copy, svg, script, style, link').forEach((node) => (node as HTMLElement).contentEditable = 'false');
        setStatus(source.comments.length ? `ローカル編集 · コメント ${source.comments.length}` : 'ローカル編集', 'ready');
      } catch (error) { setStatus(error instanceof Error ? error.message : 'ローカル編集を開始できません。', 'error'); }
    }

    content.addEventListener('input', scheduleSave, { signal: controller.signal });
    content.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) event.preventDefault(); }, { signal: controller.signal });
    document.addEventListener('selectionchange', updateBubble, { signal: controller.signal });
    document.addEventListener('keydown', (event) => {
      const isEditing = content.contains(document.activeElement);
      if ((event.ctrlKey || event.metaKey) && isEditing) {
        const key = event.key.toLowerCase();
        if (key === 's') { event.preventDefault(); void saveNow(); }
        if (key === 'b' || key === 'i') { event.preventDefault(); document.execCommand(key === 'b' ? 'bold' : 'italic', false); scheduleSave(); }
      }
      if (event.key === 'Escape') { bubble.hidden = true; compose.hidden = true; comments.hidden = true; }
    }, { signal: controller.signal });
    bubble.addEventListener('pointerdown', (event) => event.preventDefault(), { signal: controller.signal });
    ui.querySelector('[data-hb-comment-open]')?.addEventListener('click', () => { if (!selectedRange || !selectedText) return; composeSelection.textContent = selectedText; composeText.value = ''; composeError.textContent = ''; const rect = bubble.getBoundingClientRect(); bubble.hidden = true; positionNear(compose, rect, 6); composeText.focus(); }, { signal: controller.signal });
    ui.querySelector('[data-hb-comment-cancel]')?.addEventListener('click', () => { compose.hidden = true; }, { signal: controller.signal });
    ui.querySelector('[data-hb-comment-save]')?.addEventListener('click', async () => { if (!source || !selectedText || !composeText.value.trim()) return; composeError.textContent = '保存中…'; try { if (!await saveNow()) throw new Error('本文を保存できませんでした。'); const latest = await getSource(); await post({ comment: { selection: selectedText, message: composeText.value.trim() }, hash: latest.hash }); source = await getSource(); renderComments(source.comments); compose.hidden = true; setStatus(`ローカル編集 · コメント ${source.comments.length}`, 'saved'); } catch (error) { composeError.textContent = error instanceof Error ? error.message : 'コメントを保存できませんでした。'; } }, { signal: controller.signal });
    status.addEventListener('click', () => { if (!source?.comments.length) return; comments.hidden = !comments.hidden; }, { signal: controller.signal });
    ui.querySelector('[data-hb-comments-close]')?.addEventListener('click', () => { comments.hidden = true; }, { signal: controller.signal });
    commentsList.addEventListener('click', async (event) => { const button = (event.target as Element).closest<HTMLButtonElement>('[data-remove-comment]'); if (!button?.dataset.removeComment || !source) return; try { const latest = await getSource(); await post({ removeCommentId: button.dataset.removeComment, hash: latest.hash }); source = await getSource(); renderComments(source.comments); if (!source.comments.length) comments.hidden = true; setStatus(source.comments.length ? `ローカル編集 · コメント ${source.comments.length}` : 'ローカル編集', 'saved'); } catch { button.textContent = '削除できませんでした'; } }, { signal: controller.signal });
    document.addEventListener('astro:before-swap', () => { void saveNow(); window.clearTimeout(saveTimer); controller.abort(); const highlights = (CSS as typeof CSS & { highlights?: Map<string, unknown> }).highlights; highlights?.delete('hb-doc-comments'); }, { once: true, signal: controller.signal });
    void initialize();
  }

  bindEditor();
  if (!window.__hbDocsEditorNavigationBound) { window.__hbDocsEditorNavigationBound = true; document.addEventListener('astro:after-swap', bindEditor); }
</script>
