---
/**
 * Footer override.
 *
 * Starlight default の Footer (pagination + edit-this-page + last-updated)
 * の下にサイトフッターを追加する。
 *
 * default Footer を import + 同一 props で再描画 → そのままの機能を維持。
 */
import Default from '@astrojs/starlight/components/Footer.astro';

const year = new Date().getFullYear();
// 現在のロケールを維持する: EN ページではフッターの内部リンクを /en/ 配下に向ける。
const isEn = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/');
const lp = isEn ? '/en' : '';
// 左端は装飾の四角ではなく、公式サイトへのリンクと分かる文言にする。
const officialLabel = isEn ? 'Hapbeat official site' : 'Hapbeat 公式サイト';
---

<Default {...Astro.props}><slot /></Default>

<footer class="hb-footer">
  <div class="hb-footer__inner">
    <div class="hb-footer__brand">
      <a class="hb-footer__official" href="https://hapbeat.com/" target="_blank" rel="noopener noreferrer">
        {officialLabel}
        <svg viewBox="0 0 14 14" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="5" y1="9" x2="13" y2="1"/>
          <polyline points="8.5,1 13,1 13,5.5"/>
          <path d="M7,1.5 H2.5 C1.67,1.5 1,2.17 1,3 V11.5 C1,12.33 1.67,13 2.5,13 H11.5 C12.33,13 13,12.33 13,11.5 V8"/>
        </svg>
      </a>
      <span>© {year} Hapbeat — devtools.hapbeat.com</span>
    </div>
    <ul class="hb-footer__links">
      <li><a href="https://hapbeat.com/products/" target="_blank" rel="noopener noreferrer">{isEn ? 'Products' : '製品'}</a></li>
      <li><a href="https://shop.hapbeat.com/" target="_blank" rel="noopener noreferrer">{isEn ? 'Shop' : '購入'}</a></li>
      <li><a href="https://github.com/hapbeat" target="_blank" rel="noopener">GitHub</a></li>
      <li><a href={`${lp}/docs/support/contact/`}>Support</a></li>
      <li><a href={`${lp}/docs/support/changelog/`}>Changelog</a></li>
    </ul>
  </div>
</footer>

<style>
  .hb-footer {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--hb-line);
    font-size: 13px;
    color: var(--hb-ink-mute);
  }
  .hb-footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }
  .hb-footer__brand {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
  }
  .hb-footer__official {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border: 1px solid var(--hb-line-strong);
    border-radius: 999px;
    color: var(--hb-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .hb-footer__official:hover {
    background: var(--hb-bg-soft);
  }
  .hb-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
  }
  .hb-footer__links a {
    color: var(--hb-ink-mute);
    text-decoration: none;
  }
  .hb-footer__links a:hover {
    color: var(--hb-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 40rem) {
    .hb-footer__inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
