---
/**
 * ShowcaseCard — /demos/showcase/ (デモ一覧) のタイル。
 *
 * 商談・訪問デモの場でタブレットに出して「どれを体験しますか」と選んでもらう
 * ためのカード。サムネイル + カテゴリ + タイトル + 1〜2 行の説明 + 要点。
 * カード全体が詳細ページ (/demos/showcase/<id>/) へのリンク (同じタブで遷移し、
 * 詳細ページの「デモ一覧へ」で戻る)。詳細ページの PV が自動再生されるよう、
 * ClientRouter の差し替えではなく通常のページ読み込みで開く (data-astro-reload)。
 *
 * data-cats はカテゴリ絞り込み (pages/demos/showcase/index.astro の CSS) が参照する。
 */
import type { ShowcaseDemo } from '../data/showcase';
import { categoryLabel } from '../data/showcase';
import ShowcaseThumb from './ShowcaseThumb.astro';

interface Props {
  demo: ShowcaseDemo;
}

const { demo } = Astro.props;
---

<a class="hb-sc-card" href={`/demos/showcase/${demo.id}/`} data-astro-reload data-cats={demo.categories.join(' ')} style={`--_hue: ${demo.hue}`}>
  <div class="hb-sc-card__media">
    <ShowcaseThumb demo={demo} />
  </div>
  <div class="hb-sc-card__body">
    <ul class="hb-sc-card__cats">
      {demo.categories.map((c) => <li>{categoryLabel(c)}</li>)}
    </ul>
    <h2 class="hb-sc-card__title">
      {demo.title}
      {demo.subtitle && <span class="hb-sc-card__sub">{demo.subtitle}</span>}
    </h2>
    <p class="hb-sc-card__tagline">{demo.tagline}</p>
    <ul class="hb-sc-card__meta">
      {demo.meta.map((m) => <li>{m}</li>)}
    </ul>
  </div>
</a>

<style>
  .hb-sc-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hb-line);
    border-radius: var(--hb-radius-lg);
    background: var(--hb-bg-elev);
    box-shadow: var(--hb-shadow-sm);
    overflow: hidden;
    color: inherit;
    text-decoration: none !important;
    transition:
      transform 0.18s ease,
      box-shadow 0.2s ease,
      border-color 0.18s ease;
  }
  .hb-sc-card:hover,
  .hb-sc-card:focus-visible {
    transform: translateY(-4px);
    border-color: oklch(0.62 0.13 var(--_hue));
    box-shadow: var(--hb-shadow-lg);
  }
  .hb-sc-card:active {
    transform: translateY(-1px);
  }

  .hb-sc-card__media {
    position: relative;
    border-bottom: 1px solid var(--hb-line);
  }

  .hb-sc-card__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px 18px 18px;
    flex: 1;
  }
  .hb-sc-card__cats,
  .hb-sc-card__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .hb-sc-card__cats li {
    margin: 0;
    font-size: 11.5px;
    font-weight: 600;
    padding: 2px 9px;
    border-radius: 999px;
    color: oklch(0.42 0.12 var(--_hue));
    background: oklch(0.94 0.04 var(--_hue));
  }
  :global([data-theme='dark']) .hb-sc-card__cats li {
    color: oklch(0.9 0.08 var(--_hue));
    background: oklch(0.36 0.08 var(--_hue));
  }

  /* .sl-markdown-content h2 (components.css, 上余白 56px) より強くするため親クラスを重ねる */
  .hb-sc-card .hb-sc-card__title {
    margin: 2px 0 0;
    font-size: 19px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--hb-ink);
  }
  .hb-sc-card .hb-sc-card__title::before {
    content: none;
  }
  .hb-sc-card__sub {
    display: block;
    margin-top: 2px;
    font-size: 13px;
    font-weight: 600;
    color: var(--hb-ink-mute);
  }
  .hb-sc-card__tagline {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
    color: var(--hb-ink-soft);
  }
  .hb-sc-card__meta {
    margin-top: auto;
    padding-top: 6px;
  }
  .hb-sc-card__meta li {
    margin: 0;
    font-size: 12px;
    color: var(--hb-ink-mute);
    padding: 2px 8px;
    border: 1px solid var(--hb-line);
    border-radius: var(--hb-radius-sm);
  }
</style>
