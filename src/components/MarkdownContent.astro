---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import { searchTermsForPath } from '../lib/search-metadata.mjs';

const searchTerms = searchTermsForPath(Astro.url.pathname);
const DevDocsEditor = import.meta.env.DEV
  ? (await import('./DevDocsEditor.astro')).default
  : null;
---

<Default {...Astro.props}>
  {DevDocsEditor && <DevDocsEditor pathname={Astro.url.pathname} />}
  {searchTerms && (
    <span hidden aria-hidden="true" data-pagefind-meta="search_terms">
      {searchTerms.join(' ')}
    </span>
  )}
  <slot />
</Default>
