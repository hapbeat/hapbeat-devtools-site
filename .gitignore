# build
dist/
.astro/

# deps
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env
.env
.env.local
.env.production

# editor
.vscode/
.idea/
.claude/
.obsidian/
.DS_Store

# crash dumps / local junk
*.stackdump

# fetched docs (regenerated on build by scripts/fetch-docs.mjs)
# docs/ja/ が真の編集場所 (JA root) → src/content/docs/docs/ へ flat copy。
# docs/en/ (EN) → src/content/docs/en/docs/ へ flat copy。contracts は外部 fetch。
src/content/docs/docs/
src/content/docs/en/docs/

# Design handoff (reference material from Claude Design)
# 抽出済みの React/HTML プロトタイプは git 管理外。
# 必要に応じて design-handoff.zip を別途保存してアーカイブする。
.design-handoff/

# Internal dev notes (use workspace dev-notes/<repo-name>/ instead)
dev-notes/
CLAUDE.md
instructions/

# fetched demos (regenerated on build by scripts/fetch-demos.mjs)
# source of truth は hapbeat-js-sdk/examples/games/ 側。
public/demos/

# release feed (regenerated on build by scripts/gen-release-feed.mjs).
# 各配布チャネル (PyPI / npm / PlatformIO / GitHub) への問い合わせ結果なので
# ソースではなく生成物。CORS ヘッダは public/_headers 側で付与。
public/releases.json

# fetched @hapbeat/sdk browser vendor bundle (regenerated on build by
# scripts/fetch-demos.mjs). public/tools/metronome/ (手書きアプリ本体) は
# 対象外 — git 管理される通常のソースファイル。
public/tools/vendor/

# esp-web-tools の vendor コピー (scripts/sync-flasher-vendor.mjs が build 時に
# 再生成)。npm の固定版 dist/web をそのまま置くだけなので git には入れない。
# 同じディレクトリの bin/ (ファーム本体) は逆に git 管理対象 — ファーム repo が
# private で CI から取れないため、取り込んだものをコミットしないと配信できない。
public/tools/espnow-flasher/vendor/
